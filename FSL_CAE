[0m \u001b[1m7s\u001b[0m 7s/step - accuracy: 1.0000 - loss: 0.0016 - precision: 1.0000 - recall: 1.0000 - val_accuracy: 0.4440 - val_loss: 1.4192 - val_precision: 0.7674 - val_recall: 0.1156 - learning_rate: 0.0010\nEpoch 75/200\n\u001b[1m1/1\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 41ms/step - accuracy: 1.0000 - loss: 9.5912e-04 - precision: 1.0000 - recall: 1.0000\nEpoch 75: val_accuracy did not improve from 0.45884\n\u001b[1m1/1\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m7s\u001b[0m 7s/step - accuracy: 1.0000 - loss: 9.5912e-04 - precision: 1.0000 - recall: 1.0000 - val_accuracy: 0.4422 - val_loss: 1.4185 - val_precision: 0.7701 - val_recall: 0.1173 - learning_rate: 0.0010\nEpoch 76/200\n\u001b[1m1/1\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 41ms/step - accuracy: 1.0000 - loss: 0.0021 - precision: 1.0000 - recall: 1.0000\nEpoch 76: val_accuracy did not improve from 0.45884\n\u001b[1m1/1\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m7s\u001b[0m 7s/step - accuracy: 1.0000 - loss: 0.0021 - precision: 1.0000 - recall: 1.0000 - val_accuracy: 0.4405 - val_loss: 1.4179 - val_precision: 0.7701 - val_recall: 0.1173 - learning_rate: 0.0010\nEpoch 77/200\n\u001b[1m1/1\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 41ms/step - accuracy: 1.0000 - loss: 2.3798e-04 - precision: 1.0000 - recall: 1.0000\nEpoch 77: val_accuracy did not improve from 0.45884\n\u001b[1m1/1\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m7s\u001b[0m 7s/step - accuracy: 1.0000 - loss: 2.3798e-04 - precision: 1.0000 - recall: 1.0000 - val_accuracy: 0.4396 - val_loss: 1.4172 - val_precision: 0.7714 - val_recall: 0.1182 - learning_rate: 0.0010\nEpoch 78/200\n\u001b[1m1/1\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 40ms/step - accuracy: 1.0000 - loss: 0.0071 - precision: 1.0000 - recall: 1.0000","output_type":"stream"}],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# =========================================================\n# Improved Few-Shot Learning Model for Plant Disease Classification\n# Using Pre-trained CAE Weights from PDSE-Lite Framework\n# Optimized for high accuracy like the paper (98.35%)\n# =========================================================\nimport os\nos.environ[\"TF_CPP_MIN_LOG_LEVEL\"] = \"2\"\nos.environ[\"TF_ENABLE_ONEDNN_OPTS\"] = \"0\"\nos.environ[\"TF_DISABLE_PROFILER\"] = \"1\"\n\nimport cv2\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom tqdm import tqdm\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.utils.class_weight import compute_class_weight\nfrom sklearn.preprocessing import LabelEncoder\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers, regularizers\nfrom tensorflow.keras.applications import EfficientNetB0, ResNet50V2\nimport pandas as pd\nimport time\nimport random\nfrom collections import defaultdict\nimport seaborn as sns\n\n# ============ Improved Configuration ============\nBASE_DIR = \"/kaggle/input/apple-dataset/ATLDSD\"\nCAE_MODEL_PATH = \"/kaggle/input/weight-of-cae-model/cae_best_weights.h5\"\nIMG_SIZE = 224\nBATCH_SIZE = 16  # Smaller batch size for few-shot learning\nEPOCHS = 100    # Increased epochs for better convergence\nPATIENCE = 10    # Increased patience\nSEED = 2025\nK_SHOTS = [1, 2, 3, 4, 5]\n\n# Learning rate schedule\nINITIAL_LR = 0.001\nMIN_LR = 1e-6\n\nOUTDIR = \"few_shot_outputs\"\nos.makedirs(OUTDIR, exist_ok=True)\n\n# Set random seeds\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntf.random.set_seed(SEED)\n\n# ============ GPU Setup ============\ndef set_gpu_growth():\n    try:\n        gpus = tf.config.list_physical_devices('GPU')\n        if gpus:\n            for g in gpus:\n                tf.config.experimental.set_memory_growth(g, True)\n            print(f\"GPU found: {len(gpus)}; memory growth enabled\")\n        else:\n            print(\"No GPU detected; running on CPU\")\n    except Exception as e:\n        print(\"GPU mem-growth not set:\", e)\n\nset_gpu_growth()\n\n# ============ Improved Data Augmentation ============\ndef get_data_augmentation():\n    \"\"\"Advanced data augmentation for few-shot learning\"\"\"\n    return keras.Sequential([\n        layers.RandomFlip(\"horizontal\"),\n        layers.RandomFlip(\"vertical\"),\n        layers.RandomRotation(0.3),\n        layers.RandomZoom(0.2),\n        layers.RandomContrast(0.2),\n        layers.RandomBrightness(0.2),\n        layers.RandomTranslation(0.1, 0.1),\n    ], name=\"data_augmentation\")\n\n# ============ Improved Dataset Loading ============\nclass ImprovedFewShotDataset:\n    IMG_EXTS = (\".png\", \".jpg\", \".jpeg\", \".bmp\", \".tif\", \".tiff\")\n    \n    def __init__(self, base_dir, image_size=224):\n        self.base_dir = base_dir\n        self.image_size = image_size\n        self.class_to_idx = {}\n        self.idx_to_class = {}\n        self.image_paths, self.labels = self._discover_images()\n        self.label_encoder = LabelEncoder()\n        self.labels = self.label_encoder.fit_transform(self.labels)\n        print(f\"Total images found: {len(self.image_paths)}\")\n        print(f\"Number of disease classes: {len(self.class_to_idx)}\")\n\n    def _list_images(self, d):\n        acc = []\n        for r, _, fs in os.walk(d):\n            for f in fs:\n                if f.lower().endswith(self.IMG_EXTS):\n                    acc.append(os.path.join(r, f))\n        return acc\n\n    def _discover_images(self):\n        \"\"\"Discover all images and create class mappings\"\"\"\n        image_paths = []\n        labels = []\n        class_idx = 0\n        \n        if not os.path.exists(self.base_dir):\n            raise FileNotFoundError(f\"Base dir not found: {self.base_dir}\")\n        \n        for cls_folder in sorted(os.listdir(self.base_dir)):\n            cpath = os.path.join(self.base_dir, cls_folder)\n            if not os.path.isdir(cpath):\n                continue\n            \n            self.class_to_idx[cls_folder] = class_idx\n            self.idx_to_class[class_idx] = cls_folder\n            \n            img_dir = os.path.join(cpath, \"image\")\n            if os.path.exists(img_dir):\n                img_files = self._list_images(img_dir)\n                image_paths.extend(img_files)\n                labels.extend([class_idx] * len(img_files))\n                print(f\"{cls_folder:20} | images: {len(img_files):4d} | class_id: {class_idx}\")\n                class_idx += 1\n        \n        return image_paths, labels\n\n    def load_and_preprocess_image(self, img_path):\n        \"\"\"Enhanced image preprocessing\"\"\"\n        img = cv2.imread(img_path, cv2.IMREAD_COLOR)\n        if img is None:\n            return None\n        \n        # Convert BGR to RGB\n        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n        \n        # Apply CLAHE for better contrast\n        lab = cv2.cvtColor(img, cv2.COLOR_RGB2LAB)\n        clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))\n        lab[:,:,0] = clahe.apply(lab[:,:,0])\n        img = cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)\n        \n        # Resize with better interpolation\n        img = cv2.resize(img, (self.image_size, self.image_size), \n                        interpolation=cv2.INTER_LANCZOS4)\n        \n        # Normalize to [0, 1]\n        img = img.astype(np.float32) / 255.0\n        \n        return img\n\n    def load_images(self, paths):\n        \"\"\"Load and preprocess images from given paths\"\"\"\n        X = []\n        valid_paths = []\n        \n        for img_path in tqdm(paths, desc=\"Loading images\"):\n            img = self.load_and_preprocess_image(img_path)\n            if img is not None:\n                X.append(img)\n                valid_paths.append(img_path)\n        \n        return np.array(X, dtype=np.float32), valid_paths\n\n# ============ Stratified Few-Shot Data Preparation ============\ndef prepare_stratified_few_shot_data(dataset, k_shot):\n    \"\"\"Improved k-shot learning data split with stratification\"\"\"\n    print(f\"\\nPreparing {k_shot}-shot learning data with stratified sampling...\")\n    \n    # Group data by class\n    class_data = defaultdict(list)\n    for i, label in enumerate(dataset.labels):\n        class_data[label].append(i)\n    \n    train_indices = []\n    val_indices = []\n    test_indices = []\n    \n    # Ensure balanced sampling\n    for class_id, indices in class_data.items():\n        class_name = dataset.idx_to_class[class_id]\n        n_samples = len(indices)\n        \n        if n_samples < k_shot:\n            print(f\"Warning: Class {class_name} has only {n_samples} samples, less than k_shot={k_shot}\")\n            continue\n        \n        # Shuffle indices for this class\n        random.shuffle(indices)\n        \n        # Take k samples for training\n        train_class_indices = indices[:k_shot]\n        remaining_indices = indices[k_shot:]\n        \n        # Split remaining into validation and test (70-30 split)\n        n_remaining = len(remaining_indices)\n        val_size = int(n_remaining * 0.7)\n        val_class_indices = remaining_indices[:val_size]\n        test_class_indices = remaining_indices[val_size:]\n        \n        train_indices.extend(train_class_indices)\n        val_indices.extend(val_class_indices)\n        test_indices.extend(test_class_indices)\n        \n        print(f\"Class {class_name:15} | Total: {n_samples:3d} | Train: {len(train_class_indices):2d} | Val: {len(val_class_indices):2d} | Test: {len(test_class_indices):2d}\")\n    \n    # Shuffle the final indices\n    random.shuffle(train_indices)\n    random.shuffle(val_indices)\n    random.shuffle(test_indices)\n    \n    # Extract paths and labels\n    train_paths = [dataset.image_paths[i] for i in train_indices]\n    train_labels = [dataset.labels[i] for i in train_indices]\n    \n    val_paths = [dataset.image_paths[i] for i in val_indices]\n    val_labels = [dataset.labels[i] for i in val_indices]\n    \n    test_paths = [dataset.image_paths[i] for i in test_indices]\n    test_labels = [dataset.labels[i] for i in test_indices]\n    \n    print(f\"\\nFinal split for {k_shot}-shot learning:\")\n    print(f\"  Training samples: {len(train_indices)}\")\n    print(f\"  Validation samples: {len(val_indices)}\")\n    print(f\"  Test samples: {len(test_indices)}\")\n    \n    return (train_paths, train_labels), (val_paths, val_labels), (test_paths, test_labels)\n\n# ============ Improved CAE Feature Extractor ============\ndef create_improved_cae_feature_extractor(cae_model_path):\n    \"\"\"Create improved feature extractor from CAE\"\"\"\n    print(\"Loading CAE model for feature extraction...\")\n    \n    # Load CAE model without compilation\n    cae_model = keras.models.load_model(cae_model_path, compile=False)\n    print(\"CAE model loaded successfully\")\n    \n    # Find the encoder bottleneck (last layer before UpSampling)\n    encoder_output = None\n    for i, layer in enumerate(cae_model.layers):\n        if isinstance(layer, layers.UpSampling2D):\n            encoder_output = cae_model.layers[i-1].output\n            break\n    \n    if encoder_output is None:\n        # Fallback: use middle layer\n        encoder_output = cae_model.layers[len(cae_model.layers)//2].output\n    \n    # Create feature extractor\n    feature_extractor = keras.Model(\n        inputs=cae_model.input,\n        outputs=encoder_output,\n        name='CAE_Feature_Extractor'\n    )\n    \n    # Freeze all layers\n    for layer in feature_extractor.layers:\n        layer.trainable = False\n    \n    print(f\"Feature extractor output shape: {feature_extractor.output_shape}\")\n    return feature_extractor\n\n# ============ Advanced Few-Shot Model Architecture ============\ndef build_advanced_few_shot_model(feature_extractor, num_classes, use_attention=True):\n    \"\"\"Build advanced few-shot classification model\"\"\"\n    \n    inputs = keras.Input(shape=(224, 224, 3))\n    \n    # Data augmentation (only during training)\n    augmented = get_data_augmentation()(inputs)\n    \n    # Extract features using CAE encoder\n    features = feature_extractor(augmented, training=False)\n    \n    # Add attention mechanism if requested\n    if use_attention:\n        # Self-attention for spatial feature enhancement\n        attention = layers.MultiHeadAttention(\n            num_heads=8,\n            key_dim=64,\n            name='spatial_attention'\n        )\n        \n        # Get shape using Keras operations instead of tf.shape\n        h, w, c = features.shape[1], features.shape[2], features.shape[3]\n        \n        # Flatten spatial dimensions using Keras layers\n        features_flat = layers.Reshape((h*w, c))(features)\n        \n        # Apply attention\n        attended_features = attention(features_flat, features_flat)\n        \n        # Global average pooling\n        x = layers.GlobalAveragePooling1D()(attended_features)\n    else:\n        # Standard global average pooling\n        x = layers.GlobalAveragePooling2D()(features)\n    \n    # Advanced classification head with residual connections\n    x = layers.Dense(1024, activation='relu', \n                    kernel_regularizer=regularizers.l2(0.001))(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Dropout(0.5)(x)\n    \n    # Residual block\n    residual = x\n    x = layers.Dense(512, activation='relu', \n                    kernel_regularizer=regularizers.l2(0.001))(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.Dropout(0.3)(x)\n    \n    x = layers.Dense(512, activation='relu',\n                    kernel_regularizer=regularizers.l2(0.001))(x)\n    x = layers.BatchNormalization()(x)\n    \n    # Add residual connection\n    if residual.shape[-1] == x.shape[-1]:\n        x = layers.Add()([x, residual])\n    \n    x = layers.Dropout(0.3)(x)\n    \n    # Final layers\n    x = layers.Dense(256, activation='relu')(x)\n    x = layers.Dropout(0.2)(x)\n    \n    # Output layer with label smoothing\n    outputs = layers.Dense(num_classes, activation='softmax', name='predictions')(x)\n    \n    model = keras.Model(inputs, outputs, name='Advanced_FewShot_Classifier')\n    return model\n\n# ============ Advanced Training with Techniques from the Paper ============\n# ============ Advanced Training with Techniques from the Paper ============\ndef train_advanced_few_shot_model(model, train_data, val_data, k_shot, num_classes):\n    \"\"\"Advanced training with techniques to achieve high accuracy\"\"\"\n    X_train, y_train = train_data\n    X_val, y_val = val_data\n    \n    # Convert labels to categorical\n    y_train_cat = keras.utils.to_categorical(y_train, num_classes)\n    y_val_cat = keras.utils.to_categorical(y_val, num_classes)\n    \n    # Label smoothing for better generalization\n    label_smoothing = 0.1\n    y_train_smooth = y_train_cat * (1 - label_smoothing) + label_smoothing / num_classes\n    \n    # Dynamic batch size adjustment - ensure it's at least 2 but not larger than training samples\n    # For very small datasets, use batch size = training samples (full batch)\n    if len(X_train) <= 8:\n        effective_batch_size = len(X_train)  # Full batch training for very small datasets\n    else:\n        effective_batch_size = min(max(8, BATCH_SIZE), len(X_train))\n    \n    if effective_batch_size != BATCH_SIZE:\n        print(f\"  Adjusted batch size: {BATCH_SIZE} -> {effective_batch_size}\")\n    \n    # Calculate steps per epoch\n    steps_per_epoch = max(1, len(X_train) // effective_batch_size)\n    \n    # Use fixed learning rate\n    optimizer = keras.optimizers.Adam(\n        learning_rate=INITIAL_LR,\n        beta_1=0.9,\n        beta_2=0.999,\n        epsilon=1e-8\n    )\n    \n    # Compile with advanced metrics\n    model.compile(\n        optimizer=optimizer,\n        loss='categorical_crossentropy',\n        metrics=['accuracy', 'precision', 'recall']\n    )\n    \n    # Advanced callbacks\n    callbacks = [\n        keras.callbacks.EarlyStopping(\n            monitor='val_accuracy',\n            patience=PATIENCE,\n            restore_best_weights=True,\n            verbose=1,\n            min_delta=0.001\n        ),\n        keras.callbacks.ModelCheckpoint(\n            os.path.join(OUTDIR, f'advanced_{k_shot}shot_best_weights.weights.h5'),\n            monitor='val_accuracy',\n            save_best_only=True,\n            save_weights_only=True,\n            verbose=1\n        ),\n        keras.callbacks.ReduceLROnPlateau(\n            monitor='val_loss',\n            factor=0.5,\n            patience=10,\n            min_lr=MIN_LR,\n            verbose=1\n        ),\n        keras.callbacks.CSVLogger(\n            os.path.join(OUTDIR, f'advanced_training_log_{k_shot}shot.csv')\n        )\n    ]\n    \n    # Add learning rate scheduler\n    lr_schedule = keras.callbacks.LearningRateScheduler(\n        lambda epoch, lr: INITIAL_LR * 0.5 * (1 + np.cos(np.pi * epoch / EPOCHS)),\n        verbose=0\n    )\n    callbacks.append(lr_schedule)\n    \n    print(f\"\\nTraining advanced {k_shot}-shot model:\")\n    print(f\"  Batch size: {effective_batch_size}\")\n    print(f\"  Epochs: {EPOCHS}\")\n    print(f\"  Initial LR: {INITIAL_LR}\")\n    print(f\"  Training samples: {len(X_train)}\")\n    print(f\"  Validation samples: {len(X_val)}\")\n    print(f\"  Steps per epoch: {steps_per_epoch}\")\n    \n    # Train with advanced techniques\n    start_time = time.time()\n    \n    history = model.fit(\n        X_train, y_train_smooth,  # Use label smoothing\n        validation_data=(X_val, y_val_cat),\n        batch_size=effective_batch_size,\n        epochs=EPOCHS,\n        callbacks=callbacks,\n        verbose=1,\n        shuffle=True\n    )\n    \n    training_time = time.time() - start_time\n    print(f\"\\n{k_shot}-shot model training completed in {training_time/60:.2f} minutes\")\n    \n    return model, history\n\n# ============ Comprehensive Evaluation ============\ndef evaluate_comprehensive_model(model, test_data, k_shot, num_classes, class_names):\n    \"\"\"Comprehensive evaluation with F1-score and detailed metrics\"\"\"\n    X_test, y_test = test_data\n    y_test_cat = keras.utils.to_categorical(y_test, num_classes)\n    \n    print(f\"\\nEvaluating {k_shot}-shot model comprehensively...\")\n    \n    # Model evaluation\n    results = model.evaluate(X_test, y_test_cat, verbose=1)\n    test_loss, test_acc, test_precision, test_recall = results\n    \n    # F1-score calculation\n    f1_score = 2 * (test_precision * test_recall) / (test_precision + test_recall + 1e-8)\n    \n    # Predictions for detailed analysis\n    y_pred = model.predict(X_test, verbose=0)\n    y_pred_classes = np.argmax(y_pred, axis=1)\n    \n    # Detailed metrics\n    from sklearn.metrics import classification_report, confusion_matrix, f1_score as sklearn_f1\n    \n    # Sklearn F1-score (macro average)\n    macro_f1 = sklearn_f1(y_test, y_pred_classes, average='macro')\n    weighted_f1 = sklearn_f1(y_test, y_pred_classes, average='weighted')\n    \n    # Classification report\n    class_report = classification_report(\n        y_test, y_pred_classes,\n        target_names=class_names,\n        output_dict=True\n    )\n    \n    # Confusion matrix\n    conf_matrix = confusion_matrix(y_test, y_pred_classes)\n    \n    print(f\"\\n{k_shot}-shot Model Performance (Paper-style metrics):\")\n    print(f\"  Test Accuracy: {test_acc:.4f} ({test_acc*100:.2f}%)\")\n    print(f\"  Test Precision: {test_precision:.4f} ({test_precision*100:.2f}%)\")\n    print(f\"  Test Recall: {test_recall:.4f} ({test_recall*100:.2f}%)\")\n    print(f\"  Test F1-Score: {f1_score:.4f} ({f1_score*100:.2f}%)\")\n    print(f\"  Macro F1-Score: {macro_f1:.4f} ({macro_f1*100:.2f}%)\")\n    print(f\"  Weighted F1-Score: {weighted_f1:.4f} ({weighted_f1*100:.2f}%)\")\n    \n    # Save results\n    results_dict = {\n        'k_shot': k_shot,\n        'test_loss': test_loss,\n        'test_accuracy': test_acc,\n        'test_precision': test_precision,\n        'test_recall': test_recall,\n        'f1_score': f1_score,\n        'macro_f1_score': macro_f1,\n        'weighted_f1_score': weighted_f1,\n        'num_test_samples': len(X_test)\n    }\n    \n    return results_dict, class_report, conf_matrix, y_pred\n\n# ============ Advanced Visualization ============\n# ============ Advanced Visualization ============\n# ============ Advanced Visualization ============\ndef visualize_predictions_like_paper(model, dataset, test_data, class_names, k_shot, n_samples=6):\n    \"\"\"Create prediction visualization like Figure 11 in the paper\"\"\"\n    X_test, y_test = test_data\n    \n    # Convert to numpy arrays for easier manipulation\n    X_test_np = np.array(X_test)\n    y_test_np = np.array(y_test)\n    \n    # Get predictions\n    y_pred = model.predict(X_test_np, verbose=0)\n    y_pred_classes = np.argmax(y_pred, axis=1)\n    \n    # Select samples - 1 correct and 1 incorrect per class if available\n    selected_indices = []\n    selected_labels = []\n    selected_predictions = []\n    selected_confidences = []\n    \n    # First try to get correct predictions for each class\n    for class_id in range(len(class_names)):\n        class_indices = np.where(y_test_np == class_id)[0]\n        \n        if len(class_indices) > 0:\n            # Try to find one correct prediction\n            correct_mask = y_pred_classes[class_indices] == class_id\n            correct_indices = class_indices[correct_mask]\n            if len(correct_indices) > 0:\n                selected_indices.append(correct_indices[0])\n                selected_labels.append(y_test_np[correct_indices[0]])\n                selected_predictions.append(y_pred_classes[correct_indices[0]])\n                selected_confidences.append(y_pred[correct_indices[0]][y_pred_classes[correct_indices[0]]])\n    \n    # If we don't have enough samples, add some incorrect predictions\n    if len(selected_indices) < n_samples:\n        for class_id in range(len(class_names)):\n            class_indices = np.where(y_test_np == class_id)[0]\n            \n            if len(class_indices) > 0:\n                # Try to find one incorrect prediction\n                incorrect_mask = y_pred_classes[class_indices] != class_id\n                incorrect_indices = class_indices[incorrect_mask]\n                if len(incorrect_indices) > 0 and len(selected_indices) < n_samples:\n                    selected_indices.append(incorrect_indices[0])\n                    selected_labels.append(y_test_np[incorrect_indices[0]])\n                    selected_predictions.append(y_pred_classes[incorrect_indices[0]])\n                    selected_confidences.append(y_pred[incorrect_indices[0]][y_pred_classes[incorrect_indices[0]]])\n    \n    # If still no samples, just take the first n_samples from test set\n    if len(selected_indices) == 0:\n        print(\"Warning: No samples selected for visualization, using first available samples\")\n        n_available = min(n_samples, len(X_test_np))\n        selected_indices = list(range(n_available))\n        selected_labels = y_test_np[:n_available].tolist()\n        selected_predictions = y_pred_classes[:n_available].tolist()\n        selected_confidences = [y_pred[i][y_pred_classes[i]] for i in range(n_available)]\n    \n    # Limit to n_samples\n    selected_indices = selected_indices[:n_samples]\n    selected_labels = selected_labels[:n_samples]\n    selected_predictions = selected_predictions[:n_samples]\n    selected_confidences = selected_confidences[:n_samples]\n    \n    # Create visualization - ensure we have at least 1 row\n    n_cols = 3\n    n_rows = max(1, (len(selected_indices) + n_cols - 1) // n_cols)\n    \n    fig, axes = plt.subplots(n_rows, n_cols, figsize=(15, 5 * n_rows))\n    \n    # Handle single row case\n    if n_rows == 1:\n        axes = axes.reshape(1, -1)\n    elif n_rows > 1 and n_cols > 1:\n        axes = axes.reshape(n_rows, n_cols)\n    \n    for i, idx in enumerate(selected_indices):\n        row = i // n_cols\n        col = i % n_cols\n        \n        # Load and display image\n        img = X_test_np[idx]\n        axes[row, col].imshow(img)\n        \n        true_class = class_names[selected_labels[i]]\n        pred_class = class_names[selected_predictions[i]]\n        confidence = selected_confidences[i] * 100\n        \n        # Color coding: green for correct, red for incorrect\n        color = 'green' if selected_labels[i] == selected_predictions[i] else 'red'\n        \n        axes[row, col].set_title(\n            f'True: {true_class}\\n'\n            f'Pred: {pred_class}\\n'\n            f'Conf: {confidence:.1f}%',\n            color=color, fontsize=10, weight='bold'\n        )\n        axes[row, col].axis('off')\n    \n    # Hide empty subplots\n    for i in range(len(selected_indices), n_rows * n_cols):\n        row = i // n_cols\n        col = i % n_cols\n        if n_rows == 1:\n            axes[col].axis('off')\n        else:\n            axes[row, col].axis('off')\n    \n    plt.suptitle(f'Figure: Predictions from {k_shot}-shot Classification Model\\n'\n                f'Sample leaf images with ground truth and predicted labels',\n                fontsize=14, weight='bold')\n    plt.tight_layout()\n    \n    save_path = os.path.join(OUTDIR, f'predictions_visualization_{k_shot}shot.png')\n    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n    plt.show()\n    print(f\"Predictions visualization saved: {save_path}\")\ndef plot_enhanced_confusion_matrix(conf_matrix, class_names, k_shot, accuracy, f1_score):\n    \"\"\"Enhanced confusion matrix with accuracy and F1-score\"\"\"\n    plt.figure(figsize=(10, 8))\n    \n    # Normalize confusion matrix\n    conf_matrix_norm = conf_matrix.astype('float') / conf_matrix.sum(axis=1)[:, np.newaxis]\n    \n    # Create heatmap\n    sns.heatmap(conf_matrix_norm, annot=True, fmt='.2f', cmap='Blues',\n                xticklabels=class_names, yticklabels=class_names,\n                cbar_kws={'label': 'Normalized Frequency'})\n    \n    plt.title(f'Confusion Matrix - {k_shot}-shot Learning\\n'\n             f'Accuracy: {accuracy*100:.2f}% | F1-Score: {f1_score*100:.2f}%',\n             fontsize=14, weight='bold')\n    plt.xlabel('Predicted Label', fontsize=12)\n    plt.ylabel('True Label', fontsize=12)\n    plt.xticks(rotation=45, ha='right')\n    plt.yticks(rotation=0)\n    \n    plt.tight_layout()\n    save_path = os.path.join(OUTDIR, f'enhanced_confusion_matrix_{k_shot}shot.png')\n    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n    plt.show()\n    print(f\"Enhanced confusion matrix saved: {save_path}\")\n\n# ============ Main Function ============\ndef main():\n    \"\"\"Main execution function optimized for high accuracy\"\"\"\n    print(\"=\"*70)\n    print(\"ADVANCED Few-Shot Learning for Plant Disease Classification\")\n    print(\"Optimized for High Accuracy (Target: 98%+)\")\n    print(\"=\"*70)\n    \n    start_time = time.time()\n    \n    try:\n        # Load dataset\n        print(\"Loading disease dataset...\")\n        dataset = ImprovedFewShotDataset(BASE_DIR, IMG_SIZE)\n        \n        num_classes = len(dataset.class_to_idx)\n        class_names = [dataset.idx_to_class[i] for i in range(num_classes)]\n        \n        print(f\"\\nDataset Info:\")\n        print(f\"  Total classes: {num_classes}\")\n        print(f\"  Class names: {class_names}\")\n        \n        # Create advanced feature extractor\n        if not os.path.exists(CAE_MODEL_PATH):\n            raise FileNotFoundError(f\"CAE model not found: {CAE_MODEL_PATH}\")\n        \n        feature_extractor = create_improved_cae_feature_extractor(CAE_MODEL_PATH)\n        \n        # Results storage\n        all_results = []\n        all_histories = {}\n        \n        # Run experiments for each k-shot\n        for k_shot in K_SHOTS:\n            print(f\"\\n{'='*70}\")\n            print(f\"ADVANCED {k_shot}-shot Learning Experiment\")\n            print(f\"{'='*70}\")\n            \n            # Prepare stratified k-shot data\n            (train_paths, train_labels), (val_paths, val_labels), (test_paths, test_labels) = \\\n                prepare_stratified_few_shot_data(dataset, k_shot)\n            \n            # Load images with enhanced preprocessing\n            print(\"Loading and preprocessing images...\")\n            X_train, train_paths_valid = dataset.load_images(train_paths)\n            X_val, val_paths_valid = dataset.load_images(val_paths)\n            X_test, test_paths_valid = dataset.load_images(test_paths)\n            \n            # Adjust labels for valid images\n            train_labels = train_labels[:len(X_train)]\n            val_labels = val_labels[:len(X_val)]\n            test_labels = test_labels[:len(X_test)]\n            \n            # Build advanced model\n            model = build_advanced_few_shot_model(feature_extractor, num_classes, use_attention=True)\n            \n            print(f\"\\nAdvanced {k_shot}-shot model architecture:\")\n            model.summary()\n            \n            # Train with advanced techniques\n            model, history = train_advanced_few_shot_model(\n                model, (X_train, train_labels), (X_val, val_labels), k_shot, num_classes\n            )\n            \n            # Store history\n            all_histories[k_shot] = history\n            \n            # Comprehensive evaluation\n            results, class_report, conf_matrix, y_pred = evaluate_comprehensive_model(\n                model, (X_test, test_labels), k_shot, num_classes, class_names\n            )\n            \n            all_results.append(results)\n            \n            # Enhanced visualizations\n            plot_enhanced_confusion_matrix(conf_matrix, class_names, k_shot, \n                                         results['test_accuracy'], results['f1_score'])\n            \n            visualize_predictions_like_paper(model, dataset, (X_test, test_labels), \n                                           class_names, k_shot)\n            \n            # Save detailed results\n            pd.DataFrame([results]).to_csv(\n                os.path.join(OUTDIR, f'advanced_results_{k_shot}shot.csv'), index=False\n            )\n            \n            pd.DataFrame(class_report).T.to_csv(\n                os.path.join(OUTDIR, f'advanced_classification_report_{k_shot}shot.csv')\n            )\n            \n            print(f\"\\nAdvanced {k_shot}-shot experiment completed!\")\n            print(f\"Achieved {results['test_accuracy']*100:.2f}% accuracy and {results['f1_score']*100:.2f}% F1-score\")\n        \n        # Create comprehensive summary\n        results_df = pd.DataFrame(all_results)\n        results_df.to_csv(os.path.join(OUTDIR, 'advanced_summary_results.csv'), index=False)\n        \n        # Final summary visualization\n        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))\n        \n        # Accuracy plot\n        ax1.plot(results_df['k_shot'], results_df['test_accuracy']*100, 'bo-', \n                linewidth=3, markersize=10, label='Accuracy')\n        ax1.set_title('Few-Shot Learning Accuracy', fontsize=14, weight='bold')\n        ax1.set_xlabel('Number of Shots (K)')\n        ax1.set_ylabel('Test Accuracy (%)')\n        ax1.grid(True)\n        ax1.set_xticks(K_SHOTS)\n        ax1.set_ylim([0, 100])\n        \n        # F1-score plot\n        ax2.plot(results_df['k_shot'], results_df['f1_score']*100, 'ro-', \n                linewidth=3, markersize=10, label='F1-Score')\n        ax2.set_title('Few-Shot Learning F1-Score', fontsize=14, weight='bold')\n        ax2.set_xlabel('Number of Shots (K)')\n        ax2.set_ylabel('F1-Score (%)')\n        ax2.grid(True)\n        ax2.set_xticks(K_SHOTS)\n        ax2.set_ylim([0, 100])\n        \n        # Add annotations\n        for i, row in results_df.iterrows():\n            ax1.annotate(f'{row[\"test_accuracy\"]*100:.1f}%', \n                        (row['k_shot'], row['test_accuracy']*100),\n                        textcoords=\"offset points\", xytext=(0,10), ha='center',\n                        fontweight='bold')\n            ax2.annotate(f'{row[\"f1_score\"]*100:.1f}%', \n                        (row['k_shot'], row['f1_score']*100),\n                        textcoords=\"offset points\", xytext=(0,10), ha='center',\n                        fontweight='bold')\n        \n        plt.tight_layout()\n        save_path = os.path.join(OUTDIR, 'advanced_performance_summary.png')\n        plt.savefig(save_path, dpi=300, bbox_inches='tight')\n        plt.show()\n        \n        # Print paper-style results summary\n        print(f\"\\n{'='*70}\")\n        print(\"FINAL RESULTS SUMMARY (Paper Style)\")\n        print(f\"{'='*70}\")\n        \n        print(\"\\nPerformance Summary:\")\n        for _, row in results_df.iterrows():\n            print(f\"{row['k_shot']}-shot: {row['test_accuracy']*100:.2f}% accuracy, \"\n                  f\"{row['f1_score']*100:.2f}% F1-score\")\n    