te: 1.9531e-06\nEpoch 250/500\n\u001b[1m36/36\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 704ms/step - loss: 0.0278 - mae: 0.0173 - mse: 7.7776e-04\nEpoch 250: val_loss did not improve from 0.02977\n\u001b[1m36/36\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m27s\u001b[0m 759ms/step - loss: 0.0278 - mae: 0.0173 - mse: 7.7754e-04 - val_loss: 0.0298 - val_mae: 0.0176 - val_mse: 8.8827e-04 - learning_rate: 1.9531e-06\nEpoch 251/500\n\u001b[1m36/36\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 706ms/step - loss: 0.0278 - mae: 0.0173 - mse: 7.7773e-04\nEpoch 251: val_loss did not improve from 0.02977\n\u001b[1m36/36\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m27s\u001b[0m 762ms/step - loss: 0.0278 - mae: 0.0173 - mse: 7.7751e-04 - val_loss: 0.0298 - val_mae: 0.0176 - val_mse: 8.8827e-04 - learning_rate: 1.9531e-06\nEpoch 252/500\n\u001b[1m36/36\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 707ms/step - loss: 0.0278 - mae: 0.0173 - mse: 7.7771e-04\nEpoch 252: val_loss did not improve from 0.02977\n\u001b[1m36/36\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m27s\u001b[0m 762ms/step - loss: 0.0278 - mae: 0.0173 - mse: 7.7749e-04 - val_loss: 0.0298 - val_mae: 0.0176 - val_mse: 8.8826e-04 - learning_rate: 1.9531e-06\nEpoch 253/500\n\u001b[1m36/36\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 706ms/step - loss: 0.0278 - mae: 0.0173 - mse: 7.7768e-04\nEpoch 253: val_loss did not improve from 0.02977\n\nEpoch 253: ReduceLROnPlateau reducing learning rate to 9.765625463842298e-07.\n\u001b[1m36/36\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m27s\u001b[0m 761ms/step - loss: 0.0278 - mae: 0.0173 - mse: 7.7746e-04 - val_loss: 0.0298 - val_mae: 0.0176 - val_mse: 8.8825e-04 - learning_rate: 1.9531e-06\nEpoch 253: early stopping\nRestoring model weights from the end of the best epoch: 233.\n\nTraining completed in 118.24 minutes\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1500x1000 with 4 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Training history saved: cae_outputs/training_history.png\nLoaded best model weights from: cae_outputs/cae_best_weights.h5\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x600 with 24 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Reconstruction comparison saved: cae_outputs/reconstruction_comparison.png\n\n📊 Evaluating model performance on test set...\n\u001b[1m8/8\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m17s\u001b[0m 2s/step \nTest Set Performance:\n  MSE: 0.000951\n  MAE: 0.018465\n  RMSE: 0.030834\n  NRMSE: 0.030834\n  PSNR: 30.22 dB\nFinal model saved: cae_outputs/cae_final_model.h5\n\n✅ Pipeline completed successfully in 119.11 minutes\nAll outputs saved in: cae_outputs\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# =========================================================\n# Few-Shot Learning Model for Plant Disease Classification\n# Using Pre-trained CAE Weights from PDSE-Lite Framework\n# K-shot learning where k ∈ {1, 2, 3, 4, 5}\n# =========================================================\nimport os\nos.environ[\"TF_CPP_MIN_LOG_LEVEL\"] = \"2\"\nos.environ[\"TF_ENABLE_ONEDNN_OPTS\"] = \"0\"\nos.environ[\"TF_DISABLE_PROFILER\"] = \"1\"\n\nimport cv2\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom tqdm import tqdm\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.utils.class_weight import compute_class_weight\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nimport pandas as pd\nimport time\nimport random\nfrom collections import defaultdict\n\n# ============ Configuration ============\nBASE_DIR = \"/kaggle/input/apple-dataset/ATLDSD\"  # Change this to your dataset path\nCAE_MODEL_PATH = \"/kaggle/input/weight-of-cae-model/cae_best_weights.h5\"  # Path to pre-trained CAE model\nIMG_SIZE = 224\nEPOCHS = 100     # As specified in requirements\nPATIENCE = 10    # Early stopping patience\nSEED = 2025\nK_SHOTS = [1, 2, 3, 4, 5]  # Number of shots for few-shot learning\n\nOUTDIR = \"few_shot_outputs\"\nos.makedirs(OUTDIR, exist_ok=True)\n\n# Set random seeds for reproducibility\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntf.random.set_seed(SEED)\n\n# ============ GPU Setup ============\ndef set_gpu_growth():\n    try:\n        gpus = tf.config.list_physical_devices('GPU')\n        if gpus:\n            for g in gpus:\n                tf.config.experimental.set_memory_growth(g, True)\n            print(f\"GPU found: {len(gpus)}; memory growth enabled\")\n        else:\n            print(\"No GPU detected; running on CPU\")\n    except Exception as e:\n        print(\"GPU mem-growth not set:\", e)\n\nset_gpu_growth()\n\n# ============ Custom NRMSE Loss Function (for loading CAE) ============\ndef nrmse_loss(y_true, y_pred):\n    \"\"\"Normalized Root Mean Square Error (NRMSE) loss function\"\"\"\n    mse = tf.reduce_mean(tf.square(y_true - y_pred))\n    rmse = tf.sqrt(mse)\n    y_max = tf.reduce_max(y_true)\n    y_min = tf.reduce_min(y_true)\n    normalization_factor = y_max - y_min + 1e-8\n    nrmse = rmse / normalization_factor\n    return nrmse\n\n# ============ Dataset Loading with Disease Classes ============\nclass FewShotDiseaseDataset:\n    IMG_EXTS = (\".png\", \".jpg\", \".jpeg\", \".bmp\", \".tif\", \".tiff\")\n    \n    def __init__(self, base_dir, image_size=224):\n        self.base_dir = base_dir\n        self.image_size = image_size\n        self.class_to_idx = {}\n        self.idx_to_class = {}\n        self.image_paths, self.labels = self._discover_images()\n        print(f\"Total images found: {len(self.image_paths)}\")\n        print(f\"Number of disease classes: {len(self.class_to_idx)}\")\n\n    def _list_images(self, d):\n        acc = []\n        for r, _, fs in os.walk(d):\n            for f in fs:\n                if f.lower().endswith(self.IMG_EXTS):\n                    acc.append(os.path.join(r, f))\n        return acc\n\n    def _discover_images(self):\n        \"\"\"Discover all images and create class mappings\"\"\"\n        image_paths = []\n        labels = []\n        class_idx = 0\n        \n        if not os.path.exists(self.base_dir):\n            raise FileNotFoundError(f\"Base dir not found: {self.base_dir}\")\n        \n        for cls_folder in sorted(os.listdir(self.base_dir)):\n            cpath = os.path.join(self.base_dir, cls_folder)\n            if not os.path.isdir(cpath):\n                continue\n            \n            # Create class mapping\n            self.class_to_idx[cls_folder] = class_idx\n            self.idx_to_class[class_idx] = cls_folder\n            \n            # Look for image folder\n            img_dir = os.path.join(cpath, \"image\")\n            if os.path.exists(img_dir):\n                img_files = self._list_images(img_dir)\n                image_paths.extend(img_files)\n                labels.extend([class_idx] * len(img_files))\n                print(f\"{cls_folder:20} | images: {len(img_files):4d} | class_id: {class_idx}\")\n                class_idx += 1\n        \n        return image_paths, labels\n\n    def load_images(self, paths):\n        \"\"\"Load and preprocess images from given paths\"\"\"\n        X = []\n        for img_path in tqdm(paths, desc=\"Loading images\"):\n            img = cv2.imread(img_path, cv2.IMREAD_COLOR)\n            if img is None:\n                continue\n            \n            # Convert BGR to RGB\n            img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n            \n            # Resize image\n            img = cv2.resize(img, (self.image_size, self.image_size), \n                           interpolation=cv2.INTER_AREA)\n            \n            # Normalize to [0, 1]\n            img = img.astype(np.float32) / 255.0\n            X.append(img)\n        \n        return np.array(X, dtype=np.float32)\n\n# ============ Few-Shot Data Preparation ============\ndef prepare_few_shot_data(dataset, k_shot):\n    \"\"\"Prepare k-shot learning data split\"\"\"\n    print(f\"\\nPreparing {k_shot}-shot learning data...\")\n    \n    # Group data by class\n    class_data = defaultdict(list)\n    for i, label in enumerate(dataset.labels):\n        class_data[label].append(i)\n    \n    train_indices = []\n    val_indices = []\n    test_indices = []\n    \n    for class_id, indices in class_data.items():\n        class_name = dataset.idx_to_class[class_id]\n        n_samples = len(indices)\n        \n        # Shuffle indices for this class\n        random.shuffle(indices)\n        \n        # Take k samples for training\n        train_class_indices = indices[:k_shot]\n        remaining_indices = indices[k_shot:]\n        \n        # Split remaining into validation and test\n        n_remaining = len(remaining_indices)\n        val_size = n_remaining // 2\n        val_class_indices = remaining_indices[:val_size]\n        test_class_indices = remaining_indices[val_size:]\n        \n        train_indices.extend(train_class_indices)\n        val_indices.extend(val_class_indices)\n        test_indices.extend(test_class_indices)\n        \n        print(f\"Class {class_name:15} | Total: {n_samples:3d} | Train: {len(train_class_indices):2d} | Val: {len(val_class_indices):2d} | Test: {len(test_class_indices):2d}\")\n    \n    # Shuffle the final indices\n    random.shuffle(train_indices)\n    random.shuffle(val_indices)\n    random.shuffle(test_indices)\n    \n    # Extract paths and labels\n    train_paths = [dataset.image_paths[i] for i in train_indices]\n    train_labels = [dataset.labels[i] for i in train_indices]\n    \n    val_paths = [dataset.image_paths[i] for i in val_indices]\n    val_labels = [dataset.labels[i] for i in val_indices]\n    \n    test_paths = [dataset.image_paths[i] for i in test_indices]\n    test_labels = [dataset.labels[i] for i in test_indices]\n    \n    print(f\"\\nFinal split for {k_shot}-shot learning:\")\n    print(f\"  Training samples: {len(train_indices)}\")\n    print(f\"  Validation samples: {len(val_indices)}\")\n    print(f\"  Test samples: {len(test_indices)}\")\n    \n    return (train_paths, train_labels), (val_paths, val_labels), (test_paths, test_labels)\n\n# ============ Feature Extractor from CAE ============\ndef create_feature_extractor(cae_model_path, input_shape=(224, 224, 3)):\n    \"\"\"Create feature extractor from pre-trained CAE encoder\"\"\"\n    print(\"Loading pre-trained CAE model...\")\n    \n    # Load the pre-trained CAE model\n    cae_model = keras.models.load_model(cae_model_path, custom_objects={'nrmse_loss': nrmse_loss})\n    \n    # Extract encoder part (up to the bottleneck)\n    # Find the bottleneck layer (last encoder layer before decoder starts)\n    encoder_layers = []\n    for i, layer in enumerate(cae_model.layers):\n        encoder_layers.append(layer)\n        # Stop at the bottleneck (512 filters, before UpSampling starts)\n        if isinstance(layer, layers.Conv2D) and layer.filters == 512:\n            # Check if next layer is UpSampling2D (start of decoder)\n            if i + 1 < len(cae_model.layers):\n                next_layer = cae_model.layers[i + 1]\n                if isinstance(next_layer, layers.UpSampling2D):\n                    break\n    \n    # Create encoder model\n    encoder_input = cae_model.input\n    encoder_output = encoder_layers[-1].output\n    feature_extractor = keras.Model(encoder_input, encoder_output, name='CAE_Feature_Extractor')\n    \n    # Freeze the feature extractor weights\n    for layer in feature_extractor.layers:\n        layer.trainable = False\n    \n    print(f\"Feature extractor created with {len(feature_extractor.layers)} layers\")\n    print(f\"Feature extractor output shape: {feature_extractor.output_shape}\")\n    \n    return feature_extractor\n\n# ============ Few-Shot Classification Model ============\ndef build_few_shot_model(feature_extractor, num_classes, input_shape=(224, 224, 3)):\n    \"\"\"Build few-shot classification model using CAE features\"\"\"\n    \n    inputs = keras.Input(shape=input_shape)\n    \n    # Extract features using pre-trained CAE encoder\n    try:\n        features = feature_extractor(inputs)\n        print(f\"Features extracted successfully, shape: {features.shape}\")\n    except Exception as e:\n        print(f\"Error in feature extraction: {e}\")\n        raise\n    \n    # Add classification head\n    x = layers.GlobalAveragePooling2D()(features)\n    x = layers.Dense(512, activation='relu', name='classifier_dense1')(x)\n    x = layers.Dropout(0.5, name='classifier_dropout1')(x)\n    x = layers.Dense(256, activation='relu', name='classifier_dense2')(x)\n    x = layers.Dropout(0.3, name='classifier_dropout2')(x)\n    x = layers.Dense(128, activation='relu', name='classifier_dense3')(x)\n    x = layers.Dropout(0.2, name='classifier_dropout3')(x)\n    \n    # Output layer\n    outputs = layers.Dense(num_classes, activation='softmax', name='classifier_output')(x)\n    \n    model = keras.Model(inputs, outputs, name='FewShot_Disease_Classifier')\n    \n    # Don't compile here to avoid inheritance of metrics\n    print(\"Few-shot model created successfully (not compiled yet)\")\n    \n    return model\n\n# ============ Training Function ============\ndef train_few_shot_model(model, train_data, val_data, k_shot, num_classes):\n    \"\"\"Train the few-shot learning model\"\"\"\n    X_train, y_train = train_data\n    X_val, y_val = val_data\n    \n    # Convert labels to categorical\n    y_train_cat = keras.utils.to_categorical(y_train, num_classes)\n    y_val_cat = keras.utils.to_categorical(y_val, num_classes)\n    \n    # Calculate class weights for imbalanced data\n    class_weights = compute_class_weight(\n        'balanced',\n        classes=np.unique(y_train),\n        y=y_train\n    )\n    class_weight_dict = dict(enumerate(class_weights))\n    \n    # Compile model\n    model.compile(\n        optimizer=keras.optimizers.Adam(learning_rate=0.001),\n        loss='categorical_crossentropy',\n        metrics=['accuracy', tf.keras.metrics.TopKCategoricalAccuracy(k=3, name='top_3_accuracy')]\n    )\n    \n    # Define callbacks\n    callbacks = [\n        keras.callbacks.EarlyStopping(\n            monitor='val_loss',\n            patience=PATIENCE,\n            restore_best_weights=True,\n            verbose=1\n        ),\n        keras.callbacks.ModelCheckpoint(\n            os.path.join(OUTDIR, f'few_shot_{k_shot}shot_best_weights.h5'),\n            monitor='val_accuracy',\n            save_best_only=True,\n            save_weights_only=False,\n            verbose=1\n        ),\n        keras.callbacks.ReduceLROnPlateau(\n            monitor='val_loss',\n            factor=0.5,\n            patience=5,\n            min_lr=1e-7,\n            verbose=1\n        ),\n        keras.callbacks.CSVLogger(\n            os.path.join(OUTDIR, f'training_log_{k_shot}shot.csv')\n        )\n    ]\n    \n    print(f\"\\nTraining {k_shot}-shot model with:\")\n    print(f\"  Batch size: {k_shot}\")\n    print(f\"  Epochs: {EPOCHS}\")\n    print(f\"  Early stopping patience: {PATIENCE}\")\n    print(f\"  Training samples: {len(X_train)}\")\n    print(f\"  Validation samples: {len(X_val)}\")\n    \n    # Train the model\n    start_time = time.time()\n    history = model.fit(\n        X_train, y_train_cat,\n        validation_data=(X_val, y_val_cat),\n        batch_size=k_shot,  # Batch size = k (number of shots)\n        epochs=EPOCHS,\n        callbacks=callbacks,\n        class_weight=class_weight_dict,\n        verbose=1,\n        shuffle=True\n    )\n    \n    training_time = time.time() - start_time\n    print(f\"\\n{k_shot}-shot model training completed in {training_time/60:.2f} minutes\")\n    \n    return model, history\n\n# ============ Evaluation Function ============\ndef evaluate_few_shot_model(model, test_data, k_shot, num_classes, class_names):\n    \"\"\"Evaluate the few-shot learning model\"\"\"\n    X_test, y_test = test_data\n    y_test_cat = keras.utils.to_categorical(y_test, num_classes)\n    \n    print(f\"\\nEvaluating {k_shot}-shot model on test set...\")\n    \n    # Evaluate model\n    test_loss, test_acc, test_top3_acc = model.evaluate(X_test, y_test_cat, verbose=1)\n    \n    # Make predictions\n    y_pred = model.predict(X_test, verbose=0)\n    y_pred_classes = np.argmax(y_pred, axis=1)\n    \n    # Calculate per-class accuracy\n    from sklearn.metrics import classification_report, confusion_matrix\n    \n    # Classification report\n    class_report = classification_report(\n        y_test, y_pred_classes,\n        target_names=class_names,\n        output_dict=True\n    )\n    \n    # Confusion matrix\n    conf_matrix = confusion_matrix(y_test, y_pred_classes)\n    \n    print(f\"\\n{k_shot}-shot Model Performance:\")\n    print(f\"  Test Loss: {test_loss:.4f}\")\n    print(f\"  Test Accuracy: {test_acc:.4f}\")\n    print(f\"  Test Top-3 Accuracy: {test_top3_acc:.4f}\")\n    \n    # Save results\n    results = {\n        'k_shot': k_shot,\n        'test_loss': test_loss,\n        'test_accuracy': test_acc,\n        'test_top3_accuracy': test_top3_acc,\n        'num_test_samples': len(X_test)\n    }\n    \n    return results, class_report, conf_matrix\n\n# ============ Visualization Functions ============\ndef plot_few_shot_training_history(histories, k_shots):\n    \"\"\"Plot training histories for all k-shot experiments\"\"\"\n    fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n    \n    colors = ['blue', 'red', 'green', 'orange', 'purple']\n    \n    for i, k in enumerate(k_shots):\n        if k in histories:\n            history = histories[k]\n            color = colors[i % len(colors)]\n            \n            # Plot training and validation loss\n            axes[0, 0].plot(history.history['loss'], \n                          label=f'{k}-shot Training', color=color, linestyle='-')\n            axes[0, 0].plot(history.history['val_loss'], \n                          label=f'{k}-shot Validation', color=color, linestyle='--')\n    \n    axes[0, 0].set_title('Model Loss (Categorical Crossentropy)')\n    axes[0, 0].set_xlabel('Epoch')\n    axes[0, 0].set_ylabel('Loss')\n    axes[0, 0].legend()\n    axes[0, 0].grid(True)\n    \n    for i, k in enumerate(k_shots):\n        if k in histories:\n            history = histories[k]\n            color = colors[i % len(colors)]\n            \n            # Plot training and validation accuracy\n            axes[0, 1].plot(history.history['accuracy'], \n                          label=f'{k}-shot Training', color=color, linestyle='-')\n            axes[0, 1].plot(history.history['val_accuracy'], \n                          label=f'{k}-shot Validation', color=color, linestyle='--')\n    \n    axes[0, 1].set_title('Model Accuracy')\n    axes[0, 1].set_xlabel('Epoch')\n    axes[0, 1].set_ylabel('Accuracy')\n    axes[0, 1].legend()\n    axes[0, 1].grid(True)\n    \n    # Plot learning rate for first k-shot (if available)\n    if K_SHOTS[0] in histories and 'lr' in histories[K_SHOTS[0]].history:\n        axes[1, 0].plot(histories[K_SHOTS[0]].history['lr'], \n                       label='Learning Rate', color='green')\n        axes[1, 0].set_title('Learning Rate Schedule (1-shot example)')\n        axes[1, 0].set_xlabel('Epoch')\n        axes[1, 0].set_ylabel('Learning Rate')\n        axes[1, 0].set_yscale('log')\n        axes[1, 0].legend()\n        axes[1, 0].grid(True)\n    else:\n        axes[1, 0].axis('off')\n    \n    # Summary plot\n    if len(histories) > 0:\n        test_accs = []\n        k_values = []\n        for k in k_shots:\n            if k in histories:\n                # Get final validation accuracy\n                final_val_acc = max(histories[k].history['val_accuracy'])\n                test_accs.append(final_val_acc)\n                k_values.append(k)\n        \n        axes[1, 1].plot(k_values, test_accs, 'bo-', linewidth=2, markersize=8)\n        axes[1, 1].set_title('Best Validation Accuracy vs K-shot')\n        axes[1, 1].set_xlabel('Number of Shots (K)')\n        axes[1, 1].set_ylabel('Best Validation Accuracy')\n        axes[1, 1].grid(True)\n        axes[1, 1].set_xticks(k_values)\n    \n    plt.tight_layout()\n    save_path = os.path.join(OUTDIR, 'few_shot_training_histories.png')\n    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n    plt.show()\n    print(f\"Few-shot training histories saved: {save_path}\")\n\ndef plot_confusion_matrix(conf_matrix, class_names, k_shot):\n    \"\"\"Plot confusion matrix for k-shot model\"\"\"\n    plt.figure(figsize=(12, 10))\n    \n    # Normalize confusion matrix\n    conf_matrix_norm = conf_matrix.astype('float') / conf_matrix.sum(axis=1)[:, np.newaxis]\n    \n    import seaborn as sns\n    sns.heatmap(conf_matrix_norm, annot=True, fmt='.2f', cmap='Blues',\n                xticklabels=class_names, yticklabels=class_names)\n    \n    plt.title(f'Confusion Matrix - {k_shot}-shot Learning')\n    plt.xlabel('Predicted Label')\n    plt.ylabel('True Label')\n    plt.xticks(rotation=45, ha='right')\n    plt.yticks(rotation=0)\n    \n    plt.tight_layout()\n    save_path = os.path.join(OUTDIR, f'confusion_matrix_{k_shot}shot.png')\n    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n    plt.show()\n    print(f\"Confusion matrix saved: {save_path}\")\n\n# ============ Main Function ============\ndef main():\n    \"\"\"Main execution function for few-shot learning experiments\"\"\"\n    print(\"=\"*60)\n    print(\"Few-Shot Learning for Plant Disease Classification\")\n    print(\"Using Pre-trained CAE Features\")\n    print(\"=\"*60)\n    \n    start_time = time.time()\n    \n    try:\n        # Load dataset\n        print(\"Loading disease dataset...\")\n        dataset = FewShotDiseaseDataset(BASE_DIR, IMG_SIZE)\n        \n        num_classes = len(dataset.class_to_idx)\n        class_names = [dataset.idx_to_class[i] for i in range(num_classes)]\n        \n        print(f\"\\nDataset Info:\")\n        print(f\"  Total classes: {num_classes}\")\n        print(f\"  Class names: {class_names}\")\n        \n        # Create feature extractor from pre-trained CAE\n        if not os.path.exists(CAE_MODEL_PATH):\n            raise FileNotFoundError(f\"CAE model not found: {CAE_MODEL_PATH}\")\n        \n        feature_extractor = create_feature_extractor(CAE_MODEL_PATH)\n        \n        # Results storage\n        all_results = []\n        all_histories = {}\n        \n        # Run experiments for each k-shot\n        for k_shot in K_SHOTS:\n            print(f\"\\n{'='*60}\")\n            print(f\"Starting {k_shot}-shot learning experiment\")\n            print(f\"{'='*60}\")\n            \n            # Prepare k-shot data\n            (train_paths, train_labels), (val_paths, val_labels), (test_paths, test_labels) = \\\n                prepare_few_shot_data(dataset, k_shot)\n            \n            # Load images\n            print(\"Loading training images...\")\n            X_train = dataset.load_images(train_paths)\n            print(\"Loading validation images...\")\n            X_val = dataset.load_images(val_paths)\n            print(\"Loading test images...\")\n            X_test = dataset.load_images(test_paths)\n            \n            # Build model\n            model = build_few_shot_model(feature_extractor, num_classes)\n            print(f\"\\n{k_shot}-shot model architecture:\")\n            model.summary()\n            \n            # Train model\n            model, history = train_few_shot_model(\n                model, (X_train, train_labels), (X_val, val_labels), k_shot, num_classes\n            )\n            \n            # Store history\n            all_histories[k_shot] = history\n            \n            # Evaluate model\n            results, class_report, conf_matrix = evaluate_few_shot_model(\n                model, (X_test, test_labels), k_shot, num_classes, class_names\n            )\n            \n            all_results.append(results)\n            \n            # Plot confusion matrix\n            plot_confusion_matrix(conf_matrix, class_names, k_shot)\n            \n            # Save detailed results\n            pd.DataFrame([results]).to_csv(\n                os.path.join(OUTDIR, f'results_{k_shot}shot.csv'), index=False\n            )\n            \n            # Save classification report\n            pd.DataFrame(class_report).T.to_csv(\n                os.path.join(OUTDIR, f'classification_report_{k_shot}shot.csv')\n            )\n            \n            print(f\"\\n{k_shot}-shot experiment completed!\")\n        \n        # Plot all training histories\n        plot_few_shot_training_history(all_histories, K_SHOTS)\n        \n        # Create summary results\n        results_df = pd.DataFrame(all_results)\n        results_df.to_csv(os.path.join(OUTDIR, 'few_shot_summary_results.csv'), index=False)\n        \n        # Plot final summary\n        plt.figure(figsize=(10, 6))\n        plt.plot(results_df['k_shot'], results_df['test_accuracy'], 'bo-', linewidth=2, markersize=8)\n        plt.title('Few-Shot Learning Performance')\n        plt.xlabel('Number of Shots (K)')\n        plt.ylabel('Test Accuracy')\n        plt.grid(True)\n        plt.xticks(K_SHOTS)\n        \n        for i, row in results_df.iterrows():\n            plt.annotate(f'{row[\"test_accuracy\"]:.3f}', \n                        (row['k_shot'], row['test_accuracy']),\n                        textcoords=\"offset points\", xytext=(0,10), ha='center')\n        \n        plt.tight_layout()\n        save_path = os.path.join(OUTDIR, 'few_shot_p