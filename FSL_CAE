nvestigate in Nsight Systems.\n","output_type":"stream"},{"name":"stdout","text":"\nK=5 Segmentation Results:\n  Loss: 1.1604\n  Mean IoU: 0.2866\n  Dice Score: 0.3091\n  Accuracy: 0.9255\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1200 with 12 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Visualization saved: experiment_3_outputs/segmentation_results_k5.png\n\nSummary:\n    k      loss  mean_iou  dice_score  accuracy\n0  1  2.209605  0.232043    0.273085  0.820747\n1  2  1.359752  0.248537    0.283389  0.870987\n2  3  1.469519  0.240427    0.278978  0.837421\n3  4  1.385038  0.237517    0.275428  0.857440\n4  5  1.160433  0.286631    0.309107  0.925506\n\nSaved summary to: experiment_3_outputs/segmentation_results_summary.csv\nTotal time: 1702.5s\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# =========================================================\n# Experiment 4: End-to-End Pipeline + Severity Quantification\n# Uses CAE-initialized architectures; loads trained FSL weights\n# =========================================================\nimport os, cv2, time, json\nimport numpy as np\nimport pandas as pd\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nimport matplotlib.pyplot as plt\n\n# ---------- Config ----------\nIMG_SIZE = 224\nSEED = 2025\nnp.random.seed(SEED); tf.random.set_seed(SEED)\n\n# Paths (edit to your artifacts)\nCAE_WEIGHTS_PATH = \"cae_outputs/cae_best_weights.h5\"                 # CAE weights (for architecture parity)\nFSL_CLS_WEIGHTS = \"experiment_2_outputs/fsl_classifier_best.h5\"      # trained few-shot classifier\nFSL_SEG_WEIGHTS = \"experiment_3_outputs/fsl_segmentation_k5_best.h5\" # trained few-shot segmenter (pick best k)\n\n# Data to run inference on (all classes)\nBASE_DIR_ALL = \"/kaggle/input/apple-dataset/ATLDSD\"  # <--- same root, expects class folders with 'image' subfolder\n\nOUTDIR4 = \"experiment_4_outputs\"\nos.makedirs(OUTDIR4, exist_ok=True)\n\nCLASS_NAMES = [\n    \"Background\",           # 0 (unused in classifier)\n    \"Healthy\",              # 1\n    \"Brown spot\",           # 2\n    \"Alternaria leaf spot\", # 3\n    \"Gray spot\",            # 4\n    \"Rust\"                  # 5\n]\n# Class list used by CLASSIFIER (exclude background)\nCLS_LABELS = [\"Healthy\", \"Brown spot\", \"Alternaria leaf spot\", \"Gray spot\", \"Rust\"]\nDISEASED_SET = set(CLS_LABELS) - {\"Healthy\"}\n\nCOLOR_MAP = {\n    (0,   0,   0): 0,\n    (128, 0,   0): 1,\n    (128, 0, 128): 2,\n    (128,128,  0): 3,\n    (0,   0, 128): 4,\n    (0, 128,   0): 5,\n}\nPALETTE = {0:(0,0,0), 1:(128,0,0), 2:(128,0,128), 3:(128,128,0), 4:(0,0,128), 5:(0,128,0)}\n\ndef nrmse_loss(y_true, y_pred):\n    mse = tf.reduce_mean(tf.square(y_true - y_pred))\n    rmse = tf.sqrt(mse)\n    y_max = tf.reduce_max(y_true)\n    y_min = tf.reduce_min(y_true)\n    return rmse / (y_max - y_min + 1e-8)\n\n# ---------- CAE-initialized Encoders ----------\ndef build_shared_encoder(inputs):\n    # mirror the simple encoder used in Exp-3 so weight shapes align\n    x = layers.Conv2D(64, 3, padding='same', activation='relu', name='enc_c1')(inputs); x = layers.BatchNormalization(name='enc_bn1')(x)\n    x = layers.Conv2D(64, 3, padding='same', activation='relu', name='enc_c2')(x);     x = layers.BatchNormalization(name='enc_bn2')(x)\n    x = layers.MaxPooling2D((2,2), padding='same', name='enc_pool1')(x)\n\n    x = layers.Conv2D(128, 3, padding='same', activation='relu', name='enc_c3')(x); x = layers.BatchNormalization(name='enc_bn3')(x)\n    x = layers.Conv2D(128, 3, padding='same', activation='relu', name='enc_c4')(x); x = layers.BatchNormalization(name='enc_bn4')(x)\n    x = layers.MaxPooling2D((2,2), padding='same', name='enc_pool2')(x)\n\n    x = layers.Conv2D(256, 3, padding='same', activation='relu', name='enc_c5')(x); x = layers.BatchNormalization(name='enc_bn5')(x)\n    x = layers.Conv2D(256, 3, padding='same', activation='relu', name='enc_c6')(x); x = layers.BatchNormalization(name='enc_bn6')(x)\n    x = layers.MaxPooling2D((2,2), padding='same', name='enc_pool3')(x)\n\n    x = layers.Conv2D(512, 3, padding='same', activation='relu', name='enc_c7')(x); x = layers.BatchNormalization(name='enc_bn7')(x)\n    x = layers.Conv2D(512, 3, padding='same', activation='relu', name='enc_c8')(x); x = layers.BatchNormalization(name='enc_bn8')(x)\n    return x\n\ndef load_cae_backbone_weights(model, cae_path):\n    if cae_path and os.path.exists(cae_path):\n        try:\n            cae = keras.models.load_model(cae_path, custom_objects={'nrmse_loss': nrmse_loss})\n            # transfer conv weights where names/shape match\n            cae_layers = {l.name: l for l in cae.layers if isinstance(l, keras.layers.Conv2D)}\n            for l in model.layers:\n                if isinstance(l, keras.layers.Conv2D) and l.name in cae_layers:\n                    try:\n                        l.set_weights(cae_layers[l.name].get_weights())\n                    except Exception:\n                        pass\n            print(\"Loaded compatible CAE conv weights into encoder.\")\n        except Exception as e:\n            print(f\"CAE weight load failed (continuing): {e}\")\n    else:\n        print(\"CAE weights not found; proceeding without.\")\n\n# ---------- Few-shot Classifier ----------\ndef build_fsl_classifier(input_shape=(224,224,3), n_classes=5, cae_path=None):\n    inp = keras.Input(shape=input_shape)\n    x = build_shared_encoder(inp)\n    x = layers.GlobalAveragePooling2D()(x)\n    x = layers.Dense(256, activation='relu')(x)\n    out = layers.Dense(n_classes, activation='softmax', name='cls_head')(x)\n    m = keras.Model(inp, out, name=\"FSL_Classifier\")\n    load_cae_backbone_weights(m, cae_path)\n    return m\n\n# ---------- Few-shot Segmenter (decoder same as Exp-3) ----------\ndef build_fsl_segmenter(input_shape=(224,224,3), num_classes=6, cae_path=None):\n    inp = keras.Input(shape=input_shape)\n    # reuse same encoder blocks & names so checkpoint load works\n    x = layers.Conv2D(64, 3, padding='same', activation='relu', name='enc_c1')(inp); x = layers.BatchNormalization(name='enc_bn1')(x)\n    x = layers.Conv2D(64, 3, padding='same', activation='relu', name='enc_c2')(x);   x = layers.BatchNormalization(name='enc_bn2')(x)\n    skip1 = x; x = layers.MaxPooling2D((2,2), padding='same', name='enc_pool1')(x)\n\n    x = layers.Conv2D(128, 3, padding='same', activation='relu', name='enc_c3')(x); x = layers.BatchNormalization(name='enc_bn3')(x)\n    x = layers.Conv2D(128, 3, padding='same', activation='relu', name='enc_c4')(x); x = layers.BatchNormalization(name='enc_bn4')(x)\n    skip2 = x; x = layers.MaxPooling2D((2,2), padding='same', name='enc_pool2')(x)\n\n    x = layers.Conv2D(256, 3, padding='same', activation='relu', name='enc_c5')(x); x = layers.BatchNormalization(name='enc_bn5')(x)\n    x = layers.Conv2D(256, 3, padding='same', activation='relu', name='enc_c6')(x); x = layers.BatchNormalization(name='enc_bn6')(x)\n    skip3 = x; x = layers.MaxPooling2D((2,2), padding='same', name='enc_pool3')(x)\n\n    x = layers.Conv2D(512, 3, padding='same', activation='relu', name='enc_c7')(x); x = layers.BatchNormalization(name='enc_bn7')(x)\n    x = layers.Conv2D(512, 3, padding='same', activation='relu', name='enc_c8')(x); x = layers.BatchNormalization(name='enc_bn8')(x)\n\n    # decoder\n    x = layers.Conv2DTranspose(256, 3, strides=2, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n    x = layers.Concatenate()([x, skip3])\n    x = layers.Conv2D(256, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n\n    x = layers.Conv2DTranspose(128, 3, strides=2, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n    x = layers.Concatenate()([x, skip2])\n    x = layers.Conv2D(128, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n\n    x = layers.Conv2DTranspose(64, 3, strides=2, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n    x = layers.Concatenate()([x, skip1])\n    x = layers.Conv2D(64, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n\n    x = layers.Conv2D(32, 3, padding='same', activation='relu')(x)\n    out = layers.Conv2D(num_classes, 1, activation='softmax', name='segmentation')(x)\n\n    m = keras.Model(inp, out, name=\"FSL_Segmenter\")\n    load_cae_backbone_weights(m, cae_path)\n    return m\n\n# ---------- Load trained models ----------\n# Classifier\ncls_model = build_fsl_classifier((IMG_SIZE,IMG_SIZE,3), n_classes=len(CLS_LABELS), cae_path=CAE_WEIGHTS_PATH)\nif os.path.exists(FSL_CLS_WEIGHTS):\n    try:\n        cls_model.load_weights(FSL_CLS_WEIGHTS)\n        print(f\"Loaded classifier weights: {FSL_CLS_WEIGHTS}\")\n    except Exception as e:\n        print(f\"Classifier weight load warning: {e}\")\nelse:\n    print(\"Classifier weights not found; ensure the path is correct.\")\n\n# Segmenter\nseg_model = build_fsl_segmenter((IMG_SIZE,IMG_SIZE,3), num_classes=len(CLASS_NAMES), cae_path=CAE_WEIGHTS_PATH)\nif os.path.exists(FSL_SEG_WEIGHTS):\n    try:\n        seg_model.load_weights(FSL_SEG_WEIGHTS)\n        print(f\"Loaded segmenter weights: {FSL_SEG_WEIGHTS}\")\n    except Exception as e:\n        print(f\"Segmenter weight load warning: {e}\")\nelse:\n    print(\"Segmenter weights not found; ensure the path is correct.\")\n\n# ---------- Data listing ----------\ndef list_inference_images(root):\n    items = []\n    for cls in sorted(os.listdir(root)):\n        cpath = os.path.join(root, cls)\n        img_dir = os.path.join(cpath, \"image\")\n        if not os.path.isdir(img_dir):\n            continue\n        for r,_,fs in os.walk(img_dir):\n            for f in fs:\n                if f.lower().endswith((\".png\",\".jpg\",\".jpeg\",\".bmp\",\".tif\",\".tiff\")):\n                    items.append({\"image_path\": os.path.join(r,f), \"gt_class\": cls})\n    print(f\"Found {len(items)} images for inference.\")\n    return items\n\ndef preprocess_img(path):\n    im = cv2.imread(path, cv2.IMREAD_COLOR)\n    if im is None: \n        return None\n    im = cv2.cvtColor(im, cv2.COLOR_BGR2RGB)\n    im = cv2.resize(im, (IMG_SIZE, IMG_SIZE), interpolation=cv2.INTER_AREA)\n    return (im.astype(np.float32) / 255.0)\n\ndef mask_to_color(mask):\n    out = np.zeros((*mask.shape, 3), dtype=np.uint8)\n    for c, col in PALETTE.items():\n        out[mask == c] = col\n    return out\n\ndef compute_severity_percent(pred_mask_ids):\n    \"\"\"Severity% = diseased pixels / leaf pixels * 100\n       leaf pixels = all classes except Background(0)\n       diseased = classes {2,3,4,5}\n    \"\"\"\n    leaf = (pred_mask_ids != 0)\n    diseased = np.isin(pred_mask_ids, [2,3,4,5])\n    leaf_count = np.count_nonzero(leaf)\n    if leaf_count == 0:\n        return 0.0\n    return 100.0 * (np.count_nonzero(diseased) / leaf_count)\n\n# ---------- Inference loop ----------\nitems = list_inference_images(BASE_DIR_ALL)\nrecords = []\noverlay_dir = os.path.join(OUTDIR4, \"overlays\"); os.makedirs(overlay_dir, exist_ok=True)\n\nfor it in items:\n    ip = it[\"image_path\"]\n    img = preprocess_img(ip)\n    if img is None: \n        continue\n    x = np.expand_dims(img, 0)\n\n    # classify\n    cls_probs = cls_model.predict(x, verbose=0)[0]\n    cls_id = int(np.argmax(cls_probs))\n    pred_cls = CLS_LABELS[cls_id]\n    pred_cls_conf = float(cls_probs[cls_id])\n\n    severity = 0.0\n    seg_path = None\n\n    if pred_cls in DISEASED_SET:\n        # segment\n        seg_probs = seg_model.predict(x, verbose=0)[0]  # (H,W,C)\n        pred_mask = np.argmax(seg_probs, axis=-1).astype(np.uint8)\n        severity = compute_severity_percent(pred_mask)\n        # save overlay\n        color_mask = mask_to_color(pred_mask)\n        overlay = (0.6*img*255 + 0.4*color_mask).astype(np.uint8)\n        base = os.path.splitext(os.path.basename(ip))[0]\n        seg_path = os.path.join(overlay_dir, f\"{base}_overlay.png\")\n        cv2.imwrite(seg_path, cv2.cvtColor(overlay, cv2.COLOR_RGB2BGR))\n\n    records.append({\n        \"image_path\": ip,\n        \"gt_class\": it[\"gt_class\"],\n        \"pred_class\": pred_cls,\n        \"pred_class_conf\": pred_cls_conf,\n        \"severity_percent\": round(severity, 3),\n        \"overlay_path\": seg_path if seg_path else \"\"\n    })\n\ndf = pd.DataFrame(records)\ncsv_out = os.path.join(OUTDIR4, \"end_to_end_inference.csv\")\ndf.to_csv(csv_out, index=False)\nprint(df.head(10))\nprint(f\"\\nSaved results to: {csv_out}\")\nprint(f\"Overlays (for diseased predictions) in: {overlay_dir}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-09-04T15:51:46.043333Z","iopub.execute_input":"2025-09-04T15:51:46.043558Z","iopub.status.idle":"2025-09-04T15:56:51.416779Z","shell.execute_reply.started":"2025-09-04T15:51:46.043539Z","shell.execute_reply":"2025-09-04T15:56:51.416165Z"}},"outputs":[{"name":"stdout","text":"Loaded compatible CAE conv weights into encoder.\nClassifier weights not found; ensure the path is correct.\nLoaded compatible CAE conv weights into encoder.\nSegmenter weight load warning: Layer count mismatch when loading weights from file. Model expected 30 layers, found 22 saved layers.\nFound 1641 images for inference.\n                                          image_path              gt_class  \\\n0  /kaggle/input/apple-dataset/ATLDSD/Alternaria ...  Alternaria leaf spot   \n1  /kaggle/input/apple-dataset/ATLDSD/Alternaria ...  Alternaria leaf spot   \n2  /kaggle/input/apple-dataset/ATLDSD/Alternaria ...  Alternaria leaf spot   \n3  /kaggle/input/apple-dataset/ATLDSD/Alternaria ...  Alternaria leaf spot   \n4  /kaggle/input/apple-dataset/ATLDSD/Alternaria ...  Alternaria leaf spot   \n5  /kaggle/input/apple-dataset/ATLDSD/Alternaria ...  Alternaria leaf spot   \n6  /kaggle/input/apple-dataset/ATLDSD/Alternaria ...  Alternaria leaf spot   \n7  /kaggle/input/apple-dataset/ATLDSD/Alternaria ...  Alternaria leaf spot   \n8  /kaggle/input/apple-dataset/ATLDSD/Alternaria ...  Alternaria leaf spot   \n9  /kaggle/input/apple-dataset/ATLDSD/Alternaria ...  Alternaria leaf spot   \n\n   pred_class  pred_class_conf  severity_percent  \\\n0  Brown spot         0.200818           100.000   \n1  Brown spot         0.200795            99.998   \n2  Brown spot         0.200716           100.000   \n3  Brown spot         0.200758           100.000   \n4  Brown spot         0.200678           100.000   \n5  Brown spot         0.200715           100.000   \n6  Brown spot         0.200681           100.000   \n7  Brown spot         0.200659           100.000   \n8  Brown spot         0.200576           100.000   \n9  Brown spot         0.200681           100.000   \n\n                                       overlay_path  \n0  experiment_4_outputs/overlays/000780_overlay.png  \n1  experiment_4_outputs/overlays/000705_overlay.png  \n2  experiment_4_outputs/overlays/000748_overlay.png  \n3  experiment_4_outputs/overlays/000813_overlay.png  \n4  experiment_4_outputs/overlays/000456_overlay.png  \n5  experiment_4_outputs/overlays/000763_overlay.png  \n6  experiment_4_outputs/overlays/000737_overlay.png  \n7  experiment_4_outputs/overlays/000446_overlay.png  \n8  experiment_4_outputs/overlays/000518_overlay.png  \n9  experiment_4_outputs/overlays/000507_overlay.png  \n\nSaved results to: experiment_4_outputs/end_to_end_inference.csv\nOverlays (for diseased predictions) in: experiment_4_outputs/overlays\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# =========================================================\n# Experiment 3: Few-Shot Image Segmentation Model (Improved)\n# Uses pre-trained CAE weights for initialization\n# Background ignored in metrics & loss\n# =========================================================\n\nimport os\nimport cv2\nimport numpy as np\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers\nimport matplotlib.pyplot as plt\nimport pandas as pd\nimport time\nfrom tqdm import tqdm\n\n# ---------------- Configuration ----------------\nBASE_DIR = \"/kaggle/input/apple-dataset/ATLDSD\"\nCAE_WEIGHTS_PATH = \"cae_outputs/cae_best_weights.h5\"\nIMG_SIZE = 224\nEPOCHS = 100\nPATIENCE = 10\nBATCH_SIZE = 8\nK_VALUES = [1, 2, 3, 4, 5]\nSEED = 2025\nOUTDIR = \"experiment_3_outputs\"\nos.makedirs(OUTDIR, exist_ok=True)\n\nnp.random.seed(SEED)\ntf.random.set_seed(SEED)\n\nCLASS_NAMES = [\"Background\", \"Healthy\", \"Brown spot\", \"Alternaria leaf spot\", \"Gray spot\", \"Rust\"]\nNUM_CLASSES = len(CLASS_NAMES)\n\nCOLOR_MAP = {(0, 0, 0): 0, (128, 0, 0): 1, (128, 0, 128): 2, (128, 128, 0): 3, (0, 0, 128): 4, (0, 128, 0): 5}\nPALETTE = {0:(0,0,0), 1:(128,0,0), 2:(128,0,128), 3:(128,128,0), 4:(0,0,128), 5:(0,128,0)}\n\n# ---------------- Class Weights ----------------\npixel_counts = np.array([71568306, 34557476, 462758, 74955, 142992, 738089], dtype=np.float32)\nweights = 1.0 / (pixel_counts + 1e-6)\nweights = weights / weights.sum() * len(weights)\nweights[0] = 0.05   # Background weight down\nweights[1] = 0.2\nweights[2:] = 1.0   # Diseased full weight\nCLASS_WEIGHTS = tf.constant(weights, dtype=tf.float32)\n\n# ---------------- Utilities ----------------\ndef rgb_mask_to_classes(mask_rgb):\n    out = np.zeros(mask_rgb.shape[:2], dtype=np.uint8)\n    for (r, g, b), cls in COLOR_MAP.items():\n        diff = np.abs(mask_rgb - np.array([r, g, b], np.uint8))\n        m = (diff[...,0] <= 10) & (diff[...,1] <= 10) & (diff[...,2] <= 10)\n        out[m] = cls\n    return out\n\ndef mask_to_color(mask):\n    h, w = mask.shape\n    out = np.zeros((h, w, 3), dtype=np.uint8)\n    for c, col in PALETTE.items():\n        out[mask == c] = col\n    return out\n\n# ---------------- Losses ----------------\ndef weighted_ce_loss(y_true, y_pred):\n    y_true = tf.cast(tf.argmax(y_true, axis=-1), tf.int32)\n    weights_map = tf.gather(CLASS_WEIGHTS, y_true)\n    ce = tf.keras.losses.sparse_categorical_crossentropy(y_true, y_pred)\n    return tf.reduce_mean(ce * weights_map)\n\ndef dice_loss(y_true, y_pred, smooth=1e-6):\n    y_true_f = tf.reshape(y_true[...,1:], (-1, NUM_CLASSES-1))  # Ignore background\n    y_pred_f = tf.reshape(y_pred[...,1:], (-1, NUM_CLASSES-1))\n    inter = tf.reduce_sum(y_true_f * y_pred_f, axis=0)\n    union = tf.reduce_sum(y_true_f, axis=0) + tf.reduce_sum(y_pred_f, axis=0)\n    dice = (2*inter + smooth)/(union + smooth)\n    return 1 - tf.reduce_mean(dice)\n\ndef combined_loss(y_true, y_pred):\n    return weighted_ce_loss(y_true, y_pred) + dice_loss(y_true, y_pred)\n\n# ---------------- Metrics ----------------\ndef mean_iou_metric(y_true, y_pred):\n    y_true = tf.argmax(y_true, axis=-1)\n    y_pred = tf.argmax(y_pred, axis=-1)\n    mask = tf.not_equal(y_true, 0)\n    y_true = tf.boolean_mask(y_true, mask)\n    y_pred = tf.boolean_mask(y_pred, mask)\n    return tf.keras.metrics.MeanIoU(NUM_CLASSES-1)(y_true, y_pred)\n\ndef dice_score_metric(y_true, y_pred):\n    return 1 - dice_loss(y_true, y_pred)\n\n# ---------------- Dataset ----------------\nclass AppleLeafSegmentationDataset:\n    def __init__(self, base_dir, image_size=224):\n        self.base_dir = base_dir\n        self.image_size = image_size\n        self.image_paths, self.mask_paths, self.class_labels = self._discover_pairs()\n\n    def _discover_pairs(self):\n        imgs, msks, labels = [], [], []\n        classes = [\"Brown spot\", \"Alternaria leaf spot\", \"Gray spot\", \"Rust\"]\n        for cls in classes:\n            img_dir = os.path.join(self.base_dir, cls, \"image\")\n            msk_dir = os.path.join(self.base_dir, cls, \"label\")\n            if not os.path.exists(img_dir) or not os.path.exists(msk_dir): continue\n            img_files = sorted([os.path.join(img_dir,f) for f in os.listdir(img_dir) if f.endswith(\".png\")])\n            msk_files = sorted([os.path.join(msk_dir,f) for f in os.listdir(msk_dir) if f.endswith(\".png\")])\n            for i in range(min(len(img_files), len(msk_files))):\n                imgs.append(img_files[i]); msks.append(msk_files[i]); labels.append(cls)\n        return imgs, msks, labels\n\n    def load(self):\n        X, Y = [], []\n        for ip, mp in tqdm(zip(self.image_paths, self.mask_paths), total=len(self.image_paths)):\n            img = cv2.imread(ip); img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n            img = cv2.resize(img, (self.image_size,self.image_size))/255.0\n            msk = cv2.imread(mp); msk = cv2.cvtColor(msk, cv2.COLOR_BGR2RGB)\n            msk = cv2.resize(msk, (self.image_size,self.image_size), interpolation=cv2.INTER_NEAREST)\n            msk = rgb_mask_to_classes(msk)\n            X.append(img.astype(np.float32))\n            Y.append(msk.astype(np.uint8))\n        return np.stack(X,axis=0), np.stack(Y,axis=0), self.class_labels\n\n\n# ---------------- Model ----------------\ndef build_unet(input_shape=(224,224,3), num_classes=NUM_CLASSES):\n    inputs = keras.Input(shape=input_shape)\n    # Encoder\n    c1 = layers.Conv2D(16, 3, activation='relu', padding='same')(inputs)\n    p1 = layers.MaxPooling2D()(c1)\n    c2 = layers.Conv2D(32, 3, activation='relu', padding='same')(p1)\n    p2 = layers.MaxPooling2D()(c2)\n    # Bottleneck\n    b = layers.Conv2D(64, 3, activation='relu', padding='same')(p2)\n    # Decoder\n    u2 = layers.UpSampling2D()(b)\n    u2 = layers.Concatenate()([u2,c2])\n    c3 = layers.Conv2D(32, 3, activation='relu', padding='same')(u2)\n    u1 = layers.UpSampling2D()(c3)\n    u1 = layers.Concatenate()([u1,c1])\n    c4 = layers.Conv2D(16, 3, activation='relu', padding='same')(u1)\n    outputs = layers.Conv2D(num_classes, 1, activation='softmax')(c4)\n    return keras.Model(inputs, outputs)\n\n# ---------------- Training ----------------\ndef train_k_shot_segmentation(X_train,Y_train,X_val,Y_val,k):\n    Y_train = tf.one_hot(Y_train, NUM_CLASSES)\n    Y_val = tf.one_hot(Y_val, NUM_CLASSES)\n    model = build_unet((IMG_SIZE,IMG_SIZE,3), NUM_CLASSES)\n    model.compile(optimizer=keras.optimizers.Adam(1e-3),\n                  loss=combined_loss,\n                  metrics=[mean_iou_metric, dice_score_metric,'accuracy'])\n    callbacks=[\n        keras.callbacks.EarlyStopping(patience=PATIENCE,restore_best_weights=True),\n        keras.callbacks.ReduceLROnPlateau(factor=0.5,patience=5,min_lr=1e-7),\n        keras.callbacks.ModelCheckpoint(f\"{OUTDIR}/best_model_k{k}.h5\",save_best_only=True,monitor=\"val_mean_iou_metric\",mode=\"max\")\n    ]\n    history=model.fit(X_train,Y_train,validation_data=(X_val,Y_val),\n                      batch_size=BATCH_SIZE,epochs=EPOCHS,callbacks=callbacks,verbose=1)\n    return model, history\n\n# ---------------- Run Experiment ----------------\ndef run_experiment_3():\n    dataset = AppleLeafSegmentationDataset(BASE_DIR, IMG_SIZE)\n    X, Y, labels = dataset.load()\n\n    results = []\n    for k in K_VALUES:\n        print(f\"\\n--- Training k={k} ---\")\n        idxs = np.random.permutation(len(X))\n        n_train = min(k*len(set(labels)), len(X)//2)\n        X_train,Y_train = X[idxs[:n_train]], Y[idxs[:n_train]]\n        X_val,Y_val = X[idxs[n_train:]], Y[idxs[n_train:]]\n\n        model, hist = train_k_shot_segmentation(X_train,Y_train,X_val,Y_val,k)\n        preds = model.predict(X_val)\n        iou = mean_iou_metric(tf.one_hot(Y_val,NUM_CLASSES), preds).numpy()\n        dice = dice_score_metric(tf.one_hot(Y_val,NUM_CLASSES), preds).numpy()\n        acc = np.mean(np.argmax(preds,axis=-1)==Y_val)\n        loss = hist.history['val_loss'][-1]\n        results.append({'k':k,'accuracy':acc,'mean_iou':iou,'dice':dice,'loss':loss})\n\n    df=pd.DataFrame(results)\n    df.to_csv(f\"{OUTDIR}/experiment3_results.csv\",index=False)\n    print(df)\n\nrun_experiment_3()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-09-04T16:13:00.346588Z","iopub.execute_input":"2025-09-04T16:13:00.346858Z","iopub.status.idle":"2025-09-04T16:13:00.424240Z","shell.execute_reply.started":"2025-09-04T16:13:00.346839Z","shell.execute_reply":"2025-09-04T16:13:00.423311Z"}},"outputs":[{"name":"stderr","text":"0it [00:00, ?it/s]\n","output_type":"stream"},{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mValueError\u001b[0m                                Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_36/2608743095.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m    187\u001b[0m     \u001b[0mprint\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mdf\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    188\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 189\u001b[0;31m \u001b[0mrun_experiment_3\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m","\u001b[0;32m/tmp/ipykernel_36/2608743095.py\u001b[0m in \u001b[0;36mrun_experiment_3\u001b[0;34m()\u001b[0m\n\u001b[1;32m    165\u001b[0m \u001b[0;32mdef\u001b[0m \u001b[0mrun_experiment_3\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    166\u001b[0m     \u001b[0mdataset\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mAppleLeafSegmentationDataset\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mBASE_DIR\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mIMG_SIZE\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m--> 167\u001b[0;31m     \u001b[0mX\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mY\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mlabels\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mdataset\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mload\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    168\u001b[0m \u00