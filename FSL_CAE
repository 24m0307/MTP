h 4 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Few-shot training histories saved: few_shot_outputs/few_shot_training_histories.png\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x600 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\n============================================================\nFINAL RESULTS SUMMARY\n============================================================\n k_shot  test_loss  test_accuracy  test_top3_accuracy  num_test_samples\n      1     1.5981         0.1306              0.5812               819\n      2     1.6146         0.1689              0.7430               817\n      3     1.1856         0.4877              0.9361               814\n      4     1.3081         0.4126              0.8855               812\n      5     1.2759         0.4660              0.9308               809\n\n✅ Few-shot learning pipeline completed successfully in 40.95 minutes\nAll outputs saved in: few_shot_outputs\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# =========================================================\n# Few-Shot Learning Model for Plant Disease Classification\n# Using Pre-trained CAE Weights from PDSE-Lite Framework\n# Following the exact architecture from the paper\n# =========================================================\nimport os\nos.environ[\"TF_CPP_MIN_LOG_LEVEL\"] = \"2\"\nos.environ[\"TF_ENABLE_ONEDNN_OPTS\"] = \"0\"\nos.environ[\"TF_DISABLE_PROFILER\"] = \"1\"\n\nimport cv2\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom tqdm import tqdm\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.utils.class_weight import compute_class_weight\nfrom sklearn.preprocessing import LabelEncoder\nimport tensorflow as tf\nfrom tensorflow import keras\nfrom tensorflow.keras import layers, regularizers\nfrom tensorflow.keras.applications import EfficientNetB0, ResNet50V2\nimport pandas as pd\nimport time\nimport random\nfrom collections import defaultdict\nimport seaborn as sns\n\n# ============ Configuration ============\nBASE_DIR = \"/kaggle/input/apple-dataset/ATLDSD\"\nCAE_MODEL_PATH = \"/kaggle/input/weight-of-cae-model/cae_best_weights.h5\"\nIMG_SIZE = 224\nBATCH_SIZE = 32  # Increased batch size as per paper\nEPOCHS = 200     # Sufficient epochs for convergence\nPATIENCE = 30    # Patient early stopping\nSEED = 2025\nK_SHOTS = [1, 2, 3, 4, 5]\n\n# Learning rate\nINITIAL_LR = 0.001\nMIN_LR = 1e-6\n\nOUTDIR = \"few_shot_outputs\"\nos.makedirs(OUTDIR, exist_ok=True)\n\n# Set random seeds\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntf.random.set_seed(SEED)\n\n# ============ GPU Setup ============\ndef set_gpu_growth():\n    try:\n        gpus = tf.config.list_physical_devices('GPU')\n        if gpus:\n            for g in gpus:\n                tf.config.experimental.set_memory_growth(g, True)\n            print(f\"GPU found: {len(gpus)}; memory growth enabled\")\n        else:\n            print(\"No GPU detected; running on CPU\")\n    except Exception as e:\n        print(\"GPU mem-growth not set:\", e)\n\nset_gpu_growth()\n\n# ============ Data Augmentation ============\ndef get_data_augmentation():\n    \"\"\"Data augmentation as per paper\"\"\"\n    return keras.Sequential([\n        layers.RandomFlip(\"horizontal\"),\n        layers.RandomRotation(0.2),\n        layers.RandomZoom(0.2),\n        layers.RandomContrast(0.2),\n    ], name=\"data_augmentation\")\n\n# ============ Dataset Loading ============\nclass ImprovedFewShotDataset:\n    IMG_EXTS = (\".png\", \".jpg\", \".jpeg\", \".bmp\", \".tif\", \".tiff\")\n    \n    def __init__(self, base_dir, image_size=224):\n        self.base_dir = base_dir\n        self.image_size = image_size\n        self.class_to_idx = {}\n        self.idx_to_class = {}\n        self.image_paths, self.labels = self._discover_images()\n        self.label_encoder = LabelEncoder()\n        self.labels = self.label_encoder.fit_transform(self.labels)\n        print(f\"Total images found: {len(self.image_paths)}\")\n        print(f\"Number of disease classes: {len(self.class_to_idx)}\")\n\n    def _list_images(self, d):\n        acc = []\n        for r, _, fs in os.walk(d):\n            for f in fs:\n                if f.lower().endswith(self.IMG_EXTS):\n                    acc.append(os.path.join(r, f))\n        return acc\n\n    def _discover_images(self):\n        \"\"\"Discover all images and create class mappings\"\"\"\n        image_paths = []\n        labels = []\n        class_idx = 0\n        \n        if not os.path.exists(self.base_dir):\n            raise FileNotFoundError(f\"Base dir not found: {self.base_dir}\")\n        \n        for cls_folder in sorted(os.listdir(self.base_dir)):\n            cpath = os.path.join(self.base_dir, cls_folder)\n            if not os.path.isdir(cpath):\n                continue\n            \n            self.class_to_idx[cls_folder] = class_idx\n            self.idx_to_class[class_idx] = cls_folder\n            \n            img_dir = os.path.join(cpath, \"image\")\n            if os.path.exists(img_dir):\n                img_files = self._list_images(img_dir)\n                image_paths.extend(img_files)\n                labels.extend([class_idx] * len(img_files))\n                print(f\"{cls_folder:20} | images: {len(img_files):4d} | class_id: {class_idx}\")\n                class_idx += 1\n        \n        return image_paths, labels\n\n    def load_and_preprocess_image(self, img_path):\n        \"\"\"Image preprocessing\"\"\"\n        img = cv2.imread(img_path, cv2.IMREAD_COLOR)\n        if img is None:\n            return None\n        \n        # Convert BGR to RGB\n        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n        \n        # Resize\n        img = cv2.resize(img, (self.image_size, self.image_size), \n                        interpolation=cv2.INTER_LANCZOS4)\n        \n        # Normalize to [0, 1]\n        img = img.astype(np.float32) / 255.0\n        \n        return img\n\n    def load_images(self, paths):\n        \"\"\"Load and preprocess images from given paths\"\"\"\n        X = []\n        valid_paths = []\n        \n        for img_path in tqdm(paths, desc=\"Loading images\"):\n            img = self.load_and_preprocess_image(img_path)\n            if img is not None:\n                X.append(img)\n                valid_paths.append(img_path)\n        \n        return np.array(X, dtype=np.float32), valid_paths\n\n# ============ Stratified Few-Shot Data Preparation ============\ndef prepare_stratified_few_shot_data(dataset, k_shot):\n    \"\"\"K-shot learning data split with stratification\"\"\"\n    print(f\"\\nPreparing {k_shot}-shot learning data with stratified sampling...\")\n    \n    # Group data by class\n    class_data = defaultdict(list)\n    for i, label in enumerate(dataset.labels):\n        class_data[label].append(i)\n    \n    train_indices = []\n    val_indices = []\n    test_indices = []\n    \n    # Ensure balanced sampling\n    for class_id, indices in class_data.items():\n        class_name = dataset.idx_to_class[class_id]\n        n_samples = len(indices)\n        \n        if n_samples < k_shot:\n            print(f\"Warning: Class {class_name} has only {n_samples} samples, less than k_shot={k_shot}\")\n            continue\n        \n        # Shuffle indices for this class\n        random.shuffle(indices)\n        \n        # Take k samples for training\n        train_class_indices = indices[:k_shot]\n        remaining_indices = indices[k_shot:]\n        \n        # Split remaining into validation and test (70-30 split)\n        n_remaining = len(remaining_indices)\n        val_size = int(n_remaining * 0.7)\n        val_class_indices = remaining_indices[:val_size]\n        test_class_indices = remaining_indices[val_size:]\n        \n        train_indices.extend(train_class_indices)\n        val_indices.extend(val_class_indices)\n        test_indices.extend(test_class_indices)\n        \n        print(f\"Class {class_name:15} | Total: {n_samples:3d} | Train: {len(train_class_indices):2d} | Val: {len(val_class_indices):2d} | Test: {len(test_class_indices):2d}\")\n    \n    # Shuffle the final indices\n    random.shuffle(train_indices)\n    random.shuffle(val_indices)\n    random.shuffle(test_indices)\n    \n    # Extract paths and labels\n    train_paths = [dataset.image_paths[i] for i in train_indices]\n    train_labels = [dataset.labels[i] for i in train_indices]\n    \n    val_paths = [dataset.image_paths[i] for i in val_indices]\n    val_labels = [dataset.labels[i] for i in val_indices]\n    \n    test_paths = [dataset.image_paths[i] for i in test_indices]\n    test_labels = [dataset.labels[i] for i in test_indices]\n    \n    print(f\"\\nFinal split for {k_shot}-shot learning:\")\n    print(f\"  Training samples: {len(train_indices)}\")\n    print(f\"  Validation samples: {len(val_indices)}\")\n    print(f\"  Test samples: {len(test_indices)}\")\n    \n    return (train_paths, train_labels), (val_paths, val_labels), (test_paths, test_labels)\n\n# ============ CAE Feature Extractor ============\ndef create_cae_feature_extractor(cae_model_path):\n    \"\"\"Create feature extractor from CAE as per paper\"\"\"\n    print(\"Loading CAE model for feature extraction...\")\n    \n    # Load CAE model without compilation\n    cae_model = keras.models.load_model(cae_model_path, compile=False)\n    print(\"CAE model loaded successfully\")\n    \n    # Get the bottleneck layer (encoder output)\n    encoder_output = None\n    for layer in cae_model.layers:\n        if 'bottleneck' in layer.name.lower() or 'encoded' in layer.name.lower():\n            encoder_output = layer.output\n            break\n    \n    if encoder_output is None:\n        # Fallback: use the layer before the first UpSampling\n        for i, layer in enumerate(cae_model.layers):\n            if isinstance(layer, layers.UpSampling2D):\n                encoder_output = cae_model.layers[i-1].output\n                break\n    \n    if encoder_output is None:\n        # Final fallback: use the middle layer\n        encoder_output = cae_model.layers[len(cae_model.layers)//2].output\n    \n    # Create feature extractor\n    feature_extractor = keras.Model(\n        inputs=cae_model.input,\n        outputs=encoder_output,\n        name='CAE_Feature_Extractor'\n    )\n    \n    # Freeze all layers\n    for layer in feature_extractor.layers:\n        layer.trainable = False\n    \n    print(f\"Feature extractor output shape: {feature_extractor.output_shape}\")\n    return feature_extractor\n\n# ============ Paper's Exact Architecture ============\ndef build_paper_architecture(feature_extractor, num_classes):\n    \"\"\"Build the exact architecture from the paper\"\"\"\n    \n    inputs = keras.Input(shape=(224, 224, 3))\n    \n    # Data augmentation (only during training)\n    augmented = get_data_augmentation()(inputs)\n    \n    # Extract features using CAE encoder\n    features = feature_extractor(augmented, training=False)\n    \n    # Paper's classification block: Two convolutional layers + MaxPooling\n    x = layers.Conv2D(64, (3, 3), activation='relu', padding='same')(features)\n    x = layers.BatchNormalization()(x)\n    \n    x = layers.Conv2D(128, (3, 3), activation='relu', padding='same')(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.MaxPooling2D((2, 2))(x)\n    \n    # Global Average Pooling as per paper\n    x = layers.GlobalAveragePooling2D()(x)\n    \n    # Dense layers\n    x = layers.Dense(256, activation='relu')(x)\n    x = layers.Dropout(0.5)(x)\n    \n    x = layers.Dense(128, activation='relu')(x)\n    x = layers.Dropout(0.3)(x)\n    \n    # Output layer\n    outputs = layers.Dense(num_classes, activation='softmax', name='predictions')(x)\n    \n    model = keras.Model(inputs, outputs, name='PDSE_Lite_Classifier')\n    return model\n\n# ============ Training Function ============\ndef train_few_shot_model(model, train_data, val_data, k_shot, num_classes):\n    \"\"\"Train the few-shot model\"\"\"\n    X_train, y_train = train_data\n    X_val, y_val = val_data\n    \n    # Convert labels to categorical\n    y_train_cat = keras.utils.to_categorical(y_train, num_classes)\n    y_val_cat = keras.utils.to_categorical(y_val, num_classes)\n    \n    # Dynamic batch size adjustment\n    effective_batch_size = min(BATCH_SIZE, len(X_train))\n    if effective_batch_size != BATCH_SIZE:\n        print(f\"  Adjusted batch size: {BATCH_SIZE} -> {effective_batch_size}\")\n    \n    # Optimizer with learning rate schedule\n    lr_schedule = keras.optimizers.schedules.ExponentialDecay(\n        INITIAL_LR,\n        decay_steps=1000,\n        decay_rate=0.9,\n        staircase=True\n    )\n    \n    optimizer = keras.optimizers.Adam(\n        learning_rate=lr_schedule,\n        beta_1=0.9,\n        beta_2=0.999,\n        epsilon=1e-8\n    )\n    \n    # Compile model\n    model.compile(\n        optimizer=optimizer,\n        loss='categorical_crossentropy',\n        metrics=['accuracy', 'precision', 'recall']\n    )\n    \n    # Callbacks\n    callbacks = [\n        keras.callbacks.EarlyStopping(\n            monitor='val_accuracy',\n            patience=PATIENCE,\n            restore_best_weights=True,\n            verbose=1,\n            min_delta=0.001\n        ),\n        keras.callbacks.ModelCheckpoint(\n            os.path.join(OUTDIR, f'paper_{k_shot}shot_best_weights.weights.h5'),\n            monitor='val_accuracy',\n            save_best_only=True,\n            save_weights_only=True,\n            verbose=1\n        ),\n        keras.callbacks.ReduceLROnPlateau(\n            monitor='val_loss',\n            factor=0.5,\n            patience=10,\n            min_lr=MIN_LR,\n            verbose=1\n        )\n    ]\n    \n    print(f\"\\nTraining {k_shot}-shot model:\")\n    print(f\"  Batch size: {effective_batch_size}\")\n    print(f\"  Epochs: {EPOCHS}\")\n    print(f\"  Learning rate: {INITIAL_LR}\")\n    print(f\"  Training samples: {len(X_train)}\")\n    print(f\"  Validation samples: {len(X_val)}\")\n    \n    # Train model\n    start_time = time.time()\n    \n    history = model.fit(\n        X_train, y_train_cat,\n        validation_data=(X_val, y_val_cat),\n        batch_size=effective_batch_size,\n        epochs=EPOCHS,\n        callbacks=callbacks,\n        verbose=1,\n        shuffle=True\n    )\n    \n    training_time = time.time() - start_time\n    print(f\"\\n{k_shot}-shot training completed in {training_time/60:.2f} minutes\")\n    \n    return model, history\n\n# ============ Evaluation ============\ndef evaluate_model(model, test_data, k_shot, num_classes, class_names):\n    \"\"\"Evaluate model performance\"\"\"\n    X_test, y_test = test_data\n    y_test_cat = keras.utils.to_categorical(y_test, num_classes)\n    \n    print(f\"\\nEvaluating {k_shot}-shot model...\")\n    \n    # Model evaluation\n    results = model.evaluate(X_test, y_test_cat, verbose=1)\n    test_loss, test_acc, test_precision, test_recall = results\n    \n    # F1-score calculation\n    f1_score = 2 * (test_precision * test_recall) / (test_precision + test_recall + 1e-8)\n    \n    # Predictions for detailed analysis\n    y_pred = model.predict(X_test, verbose=0)\n    y_pred_classes = np.argmax(y_pred, axis=1)\n    \n    # Detailed metrics\n    from sklearn.metrics import classification_report, confusion_matrix, f1_score as sklearn_f1\n    \n    macro_f1 = sklearn_f1(y_test, y_pred_classes, average='macro')\n    weighted_f1 = sklearn_f1(y_test, y_pred_classes, average='weighted')\n    \n    # Classification report\n    class_report = classification_report(\n        y_test, y_pred_classes,\n        target_names=class_names,\n        output_dict=True\n    )\n    \n    # Confusion matrix\n    conf_matrix = confusion_matrix(y_test, y_pred_classes)\n    \n    print(f\"\\n{k_shot}-shot Model Performance:\")\n    print(f\"  Test Accuracy: {test_acc:.4f} ({test_acc*100:.2f}%)\")\n    print(f\"  Test Precision: {test_precision:.4f} ({test_precision*100:.2f}%)\")\n    print(f\"  Test Recall: {test_recall:.4f} ({test_recall*100:.2f}%)\")\n    print(f\"  Test F1-Score: {f1_score:.4f} ({f1_score*100:.2f}%)\")\n    print(f\"  Macro F1-Score: {macro_f1:.4f} ({macro_f1*100:.2f}%)\")\n    \n    # Save results\n    results_dict = {\n        'k_shot': k_shot,\n        'test_loss': test_loss,\n        'test_accuracy': test_acc,\n        'test_precision': test_precision,\n        'test_recall': test_recall,\n        'f1_score': f1_score,\n        'macro_f1_score': macro_f1,\n        'weighted_f1_score': weighted_f1,\n        'num_test_samples': len(X_test)\n    }\n    \n    return results_dict, class_report, conf_matrix, y_pred\n\n# ============ Visualization ============\ndef plot_confusion_matrix(conf_matrix, class_names, k_shot, accuracy, f1_score):\n    \"\"\"Plot confusion matrix\"\"\"\n    plt.figure(figsize=(10, 8))\n    \n    # Normalize confusion matrix\n    conf_matrix_norm = conf_matrix.astype('float') / conf_matrix.sum(axis=1)[:, np.newaxis]\n    \n    # Create heatmap\n    sns.heatmap(conf_matrix_norm, annot=True, fmt='.2f', cmap='Blues',\n                xticklabels=class_names, yticklabels=class_names,\n                cbar_kws={'label': 'Normalized Frequency'})\n    \n    plt.title(f'Confusion Matrix - {k_shot}-shot Learning\\n'\n             f'Accuracy: {accuracy*100:.2f}% | F1-Score: {f1_score*100:.2f}%',\n             fontsize=14, weight='bold')\n    plt.xlabel('Predicted Label', fontsize=12)\n    plt.ylabel('True Label', fontsize=12)\n    plt.xticks(rotation=45, ha='right')\n    plt.yticks(rotation=0)\n    \n    plt.tight_layout()\n    save_path = os.path.join(OUTDIR, f'confusion_matrix_{k_shot}shot.png')\n    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n    plt.show()\n    print(f\"Confusion matrix saved: {save_path}\")\n\n# ============ Main Function ============\ndef main():\n    \"\"\"Main execution function\"\"\"\n    print(\"=\"*70)\n    print(\"Few-Shot Learning for Plant Disease Classification\")\n    print(\"Following PDSE-Lite Paper Architecture\")\n    print(\"=\"*70)\n    \n    start_time = time.time()\n    \n    try:\n        # Load dataset\n        print(\"Loading disease dataset...\")\n        dataset = ImprovedFewShotDataset(BASE_DIR, IMG_SIZE)\n        \n        num_classes = len(dataset.class_to_idx)\n        class_names = [dataset.idx_to_class[i] for i in range(num_classes)]\n        \n        print(f\"\\nDataset Info:\")\n        print(f\"  Total classes: {num_classes}\")\n        print(f\"  Class names: {class_names}\")\n        \n        # Create feature extractor\n        if not os.path.exists(CAE_MODEL_PATH):\n            raise FileNotFoundError(f\"CAE model not found: {CAE_MODEL_PATH}\")\n        \n        feature_extractor = create_cae_feature_extractor(CAE_MODEL_PATH)\n        \n        # Results storage\n        all_results = []\n        \n        # Run experiments for each k-shot\n        for k_shot in K_SHOTS:\n            print(f\"\\n{'='*70}\")\n            print(f\"{k_shot}-shot Learning Experiment\")\n            print(f\"{'='*70}\")\n            \n            # Prepare stratified k-shot data\n            (train_paths, train_labels), (val_paths, val_labels), (test_paths, test_labels) = \\\n                prepare_stratified_few_shot_data(dataset, k_shot)\n            \n            # Load images\n            print(\"Loading and preprocessing images...\")\n            X_train, _ = dataset.load_images(train_paths)\n            X_val, _ = dataset.load_images(val_paths)\n            X_test, _ = dataset.load_images(test_paths)\n            \n            # Adjust labels\n            train_labels = train_labels[:len(X_train)]\n            val_labels = val_labels[:len(X_val)]\n            test_labels = test_labels[:len(X_test)]\n            \n            # Build paper's architecture\n            model = build_paper_architecture(feature_extractor, num_classes)\n            \n            print(f\"\\n{k_shot}-shot model architecture:\")\n            model.summary()\n            \n            # Train model\n            model, history = train_few_shot_model(\n                model, (X_train, train_labels), (X_val, val_labels), k_shot, num_classes\n            )\n            \n            # Evaluate model\n            results, class_report, conf_matrix, y_pred = evaluate_model(\n                model, (X_test, test_labels), k_shot, num_classes, class_names\n            )\n            \n            all_results.append(results)\n            \n            # Plot confusion matrix\n            plot_confusion_matrix(conf_matrix, class_names, k_shot, \n                                 results['test_accuracy'], results['f1_score'])\n            \n            # Save results\n            pd.DataFrame([results]).to_csv(\n                os.path.join(OUTDIR, f'results_{k_shot}shot.csv'), index=False\n            )\n            \n            print(f\"\\n{k_shot}-shot experiment completed!\")\n            print(f\"Achieved {results['test_accuracy']*100:.2f}% accuracy\")\n        \n        # Create summary\n        results_df = pd.DataFrame(all_results)\n        results_df.to_csv(os.path.join(OUTDIR, 'summary_results.csv'), index=False)\n        \n        # Print summary\n        print(f\"\\n{'='*70}\")\n        print(\"FINAL RESULTS SUMMARY\")\n        print(f\"{'='*70}\")\n        \n        for _, row in results_df.iterrows():\n            print(f\"{row['k_shot']}-shot: {row['test_accuracy']*100:.2f}% accuracy, \"\n                  f\"{row['f1_score']*100:.2f}% F1-score\")\n        \n        total_time = time.time() - start_time\n        print(f\"\\n✅ Few-shot learning completed in {total_time/60:.2f} minutes\")\n        print(f\"📁 All outputs saved in: {OUTDIR}\")\n        \n    except Exception as e:\n        print(f\"❌ Error occurred: {str(e)}\")\n        import traceback\n        traceback.print_exc()\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-09-07T21:19:21.126170Z","iopub.execute_input":"2025-09-07T21:19:21.126466Z"}},"outputs":[{"name":"stdout","text":"GPU found: 2; memory growth enabled\n======================================================================\nFew-Shot Learning for Plant Disease Classification\nFollowing PDSE-Lite Paper Architecture\n======================================================================\nLoading disease dataset...\nAlternaria leaf spot | images:  278 | class_id: 0\nBrown spot           | images:  215 | class_id: 1\nGray spot            | images:  395 | class_id: 2\nHealthy leaf         | images:  409 | class_id: 3\nRust                 | images:  344 | class_id: 4\nTotal images found: 1641\nNumber of disease classes: 5\n\nDataset Info:\n  Total classes: 5\n  Class names: ['Alternaria leaf spot', 'Brown spot', 'Gray spot', 'Healthy leaf', 'Rust']\nLoading CAE model for feature extraction...\nCAE model loaded successfully\nFeature extractor output shape: (None, 28, 28, 256)\n\n======================================================================\n1-shot Learning Experiment\n======================================================================\n\nPreparing 1-shot learning data with stratified sampling...\nClass Alternaria leaf spot | Total: 278 | Train:  1 | Val: 193 | Test: 84\nClass Brown spot      | Total: 215 | Train:  1 | Val: 149 | Test: 65\nClass Gray spot       | Total: 395 | Train:  1 | Val: 275 | Test: 119\nClass Healthy leaf    | Total: 409 | Train:  1 | Val: 285 | Test: 123\nClass Rust            | Total: 344 | Train:  1 | Val: 240 | Test: 103\n\nFinal split for 1-shot learning:\n  Training samples: 5\n  Validation samples: 1142\n  Test samples: 494\n