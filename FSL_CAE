 # <--- CAE weights (h5 SavedModel)\nIMG_SIZE = 224\nEPOCHS = 100\nPATIENCE = 10\nSEED = 2025\nK_VALUES = [1, 2, 3, 4, 5]  # k-shot values to test\n\nOUTDIR = \"experiment_3_outputs\"\nos.makedirs(OUTDIR, exist_ok=True)\n\n# Seeds\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntf.random.set_seed(SEED)\n\n# Class names (index aligned)\nCLASS_NAMES = [\n    \"Background\",           # 0\n    \"Healthy\",              # 1\n    \"Brown spot\",           # 2\n    \"Alternaria leaf spot\", # 3\n    \"Gray spot\",            # 4\n    \"Rust\"                  # 5\n]\nNUM_CLASSES = len(CLASS_NAMES)\n\n# Mask color mapping (RGB -> class id)\nCOLOR_MAP = {\n    (0,   0,   0): 0,   # Background\n    (128, 0,   0): 1,   # Healthy\n    (128, 0, 128): 2,   # Brown spot\n    (128,128,  0): 3,   # Alternaria\n    (0,   0, 128): 4,   # Gray\n    (0, 128,   0): 5,   # Rust\n}\nPALETTE = {0:(0,0,0), 1:(128,0,0), 2:(128,0,128), 3:(128,128,0), 4:(0,0,128), 5:(0,128,0)}\n\n# ============ GPU Setup ============\ndef set_gpu_growth():\n    try:\n        gpus = tf.config.list_physical_devices('GPU')\n        if gpus:\n            for g in gpus:\n                tf.config.experimental.set_memory_growth(g, True)\n            print(f\"GPU found: {len(gpus)}; memory growth enabled\")\n        else:\n            print(\"No GPU detected; running on CPU\")\n    except Exception as e:\n        print(\"GPU mem-growth not set:\", e)\nset_gpu_growth()\n\n# ============ Losses ============\ndef nrmse_loss(y_true, y_pred):\n    mse = tf.reduce_mean(tf.square(y_true - y_pred))\n    rmse = tf.sqrt(mse)\n    y_max = tf.reduce_max(y_true)\n    y_min = tf.reduce_min(y_true)\n    return rmse / (y_max - y_min + 1e-8)\n\ndef segmentation_categorical_crossentropy_loss(y_true, y_pred):\n    # returns (B,H,W); we reduce to scalar\n    cce = tf.keras.losses.categorical_crossentropy(y_true, y_pred)\n    return tf.reduce_mean(cce)\n\ndef segmentation_jaccard_loss(y_true, y_pred):\n    smooth = 1e-6\n    if len(y_pred.shape) > 3 and y_pred.shape[-1] > 1:\n        y_pred = tf.nn.softmax(y_pred, axis=-1)\n    y_true_flat = tf.reshape(y_true, [-1, NUM_CLASSES])\n    y_pred_flat = tf.reshape(y_pred, [-1, NUM_CLASSES])\n    intersection = tf.reduce_sum(y_true_flat * y_pred_flat, axis=0)\n    union = tf.reduce_sum(y_true_flat + y_pred_flat - y_true_flat * y_pred_flat, axis=0)\n    jaccard = (intersection + smooth) / (union + smooth)\n    return 1.0 - tf.reduce_mean(jaccard)\n\ndef combined_segmentation_loss(y_true, y_pred):\n    return segmentation_categorical_crossentropy_loss(y_true, y_pred) + segmentation_jaccard_loss(y_true, y_pred)\n\n# ============ Metrics ============\ndef mean_iou_metric(y_true, y_pred):\n    y_pred_classes = tf.argmax(y_pred, axis=-1)\n    y_true_classes = tf.argmax(y_true, axis=-1)\n    ious = []\n    for class_id in range(NUM_CLASSES):\n        true_mask = tf.equal(y_true_classes, class_id)\n        pred_mask = tf.equal(y_pred_classes, class_id)\n        intersection = tf.reduce_sum(tf.cast(tf.logical_and(true_mask, pred_mask), tf.float32))\n        union = tf.reduce_sum(tf.cast(tf.logical_or(true_mask, pred_mask), tf.float32))\n        iou = tf.cond(tf.greater(union, 0), lambda: intersection / union, lambda: tf.constant(1.0))\n        ious.append(iou)\n    return tf.reduce_mean(ious)\n\ndef dice_score_metric(y_true, y_pred):\n    smooth = 1e-6\n    y_pred_classes = tf.argmax(y_pred, axis=-1)\n    y_true_classes = tf.argmax(y_true, axis=-1)\n    dices = []\n    for class_id in range(NUM_CLASSES):\n        t = tf.cast(tf.equal(y_true_classes, class_id), tf.float32)\n        p = tf.cast(tf.equal(y_pred_classes, class_id), tf.float32)\n        inter = tf.reduce_sum(t * p)\n        union = tf.reduce_sum(t) + tf.reduce_sum(p)\n        dice = (2.0 * inter + smooth) / (union + smooth)\n        dices.append(dice)\n    return tf.reduce_mean(dices)\n\n# ============ Utils ============\ndef rgb_mask_to_classes(mask_rgb, tol=10):\n    out = np.zeros(mask_rgb.shape[:2], dtype=np.uint8)\n    for (r, g, b), cls in COLOR_MAP.items():\n        diff = np.abs(mask_rgb - np.array([r, g, b], np.uint8))\n        m = (diff[..., 0] <= tol) & (diff[..., 1] <= tol) & (diff[..., 2] <= tol)\n        out[m] = cls\n    return out\n\ndef mask_to_color(mask):\n    h, w = mask.shape\n    out = np.zeros((h, w, 3), dtype=np.uint8)\n    for c, col in PALETTE.items():\n        out[mask == c] = col\n    return out\n\n# ============ Dataset ============\nclass AppleLeafSegmentationDataset:\n    IMG_EXTS = (\".png\", \".jpg\", \".jpeg\", \".bmp\", \".tif\", \".tiff\")\n    def __init__(self, base_dir, image_size=224):\n        self.base_dir = base_dir\n        self.image_size = image_size\n        self.image_paths, self.mask_paths, self.class_labels = self._discover_pairs()\n        print(f\"Total paired samples: {len(self.image_paths)}\")\n\n    def _list_images(self, d):\n        acc = []\n        for r, _, fs in os.walk(d):\n            for f in fs:\n                if f.lower().endswith(self.IMG_EXTS):\n                    acc.append(os.path.join(r, f))\n        return acc\n\n    def _discover_pairs(self):\n        imgs, msks, labels = [], [], []\n        diseased_classes = [\"Brown spot\", \"Alternaria leaf spot\", \"Gray spot\", \"Rust\"]\n        if not os.path.exists(self.base_dir):\n            raise FileNotFoundError(f\"Base dir not found: {self.base_dir}\")\n        for cls_folder in sorted(os.listdir(self.base_dir)):\n            if cls_folder not in diseased_classes:\n                continue\n            cpath = os.path.join(self.base_dir, cls_folder)\n            if not os.path.isdir(cpath):\n                continue\n            img_dir = os.path.join(cpath, \"image\")\n            msk_dir = os.path.join(cpath, \"label\")\n            if not (os.path.exists(img_dir) and os.path.exists(msk_dir)):\n                continue\n            img_files = self._list_images(img_dir)\n            msk_files = self._list_images(msk_dir)\n            img_by = {os.path.splitext(os.path.basename(p))[0].lower(): p for p in img_files}\n            msk_by = {os.path.splitext(os.path.basename(p))[0].lower(): p for p in msk_files}\n            common = sorted(set(img_by) & set(msk_by))\n            print(f\"{cls_folder:20} | imgs:{len(img_files):4d} | masks:{len(msk_files):4d} | paired:{len(common):4d}\")\n            for s in common:\n                imgs.append(img_by[s])\n                msks.append(msk_by[s])\n                labels.append(cls_folder)\n        return imgs, msks, labels\n\n    def load(self):\n        X, Y, valid_paths = [], [], []\n        for ip, mp in tqdm(list(zip(self.image_paths, self.mask_paths)), desc=\"Loading segmentation data\"):\n            img = cv2.imread(ip, cv2.IMREAD_COLOR)\n            if img is None: \n                continue\n            img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n            img = cv2.resize(img, (self.image_size, self.image_size), interpolation=cv2.INTER_AREA)\n            img = img.astype(np.float32) / 255.0\n            msk = cv2.imread(mp, cv2.IMREAD_COLOR)\n            if msk is None:\n                continue\n            msk = cv2.cvtColor(msk, cv2.COLOR_BGR2RGB)\n            msk = cv2.resize(msk, (self.image_size, self.image_size), interpolation=cv2.INTER_NEAREST)\n            msk = rgb_mask_to_classes(msk)\n            X.append(img)\n            Y.append(msk)\n            valid_paths.append((ip, mp))\n        return np.array(X, dtype=np.float32), np.array(Y, dtype=np.uint8), valid_paths\n\n# ============ Model ============\ndef build_encoder_from_scratch(inputs):\n    x = layers.Conv2D(64, 3, padding='same', activation='relu')(inputs); x = layers.BatchNormalization()(x)\n    x = layers.Conv2D(64, 3, padding='same', activation='relu')(x);      x = layers.BatchNormalization()(x)\n    skip1 = x; x = layers.MaxPooling2D((2,2), padding='same')(x) # 112\n\n    x = layers.Conv2D(128, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n    x = layers.Conv2D(128, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n    skip2 = x; x = layers.MaxPooling2D((2,2), padding='same')(x) # 56\n\n    x = layers.Conv2D(256, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n    x = layers.Conv2D(256, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n    skip3 = x; x = layers.MaxPooling2D((2,2), padding='same')(x) # 28\n\n    x = layers.Conv2D(512, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n    x = layers.Conv2D(512, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n    return x, [skip1, skip2, skip3]\n\ndef build_few_shot_segmentation_model(input_shape=(224,224,3), cae_weights_path=None):\n    inputs = keras.Input(shape=input_shape)\n    x = inputs; skip_connections = []\n    if cae_weights_path and os.path.exists(cae_weights_path):\n        print(f\"Loading pre-trained CAE weights from: {cae_weights_path}\")\n        try:\n            cae_model = keras.models.load_model(cae_weights_path, custom_objects={'nrmse_loss': nrmse_loss})\n            encoder_layers = []\n            for layer in cae_model.layers:\n                if isinstance(layer, keras.layers.Conv2D) and \"transpose\" not in layer.name:\n                    encoder_layers.append(layer)\n                if len(encoder_layers) >= 8:\n                    break\n            skip_connections = []\n            for i, layer in enumerate(encoder_layers):\n                x = layer(x)\n                # Create 3 hierarchical skips roughly after every 2 convs with pooling in CAE design\n                if i in [1, 3, 5]:\n                    skip_connections.append(x)\n                if i in [1, 3, 5]:\n                    x = layers.MaxPooling2D((2,2), padding='same')(x)\n            print(\"Successfully loaded pre-trained encoder weights from CAE\")\n        except Exception as e:\n            print(f\"Failed to load CAE weights: {e}; building encoder from scratch\")\n            x, skip_connections = build_encoder_from_scratch(inputs)\n    else:\n        print(\"No CAE weights provided or path missing; building encoder from scratch\")\n        x, skip_connections = build_encoder_from_scratch(inputs)\n\n    # Decoder (U-Net style light)\n    x = layers.Conv2DTranspose(256, 3, strides=2, padding='same', activation='relu')(x)\n    x = layers.BatchNormalization()(x)\n    if len(skip_connections) >= 3:\n        x = layers.Concatenate()([x, skip_connections[2]])\n    x = layers.Conv2D(256, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n\n    x = layers.Conv2DTranspose(128, 3, strides=2, padding='same', activation='relu')(x)\n    x = layers.BatchNormalization()(x)\n    if len(skip_connections) >= 2:\n        x = layers.Concatenate()([x, skip_connections[1]])\n    x = layers.Conv2D(128, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n\n    x = layers.Conv2DTranspose(64, 3, strides=2, padding='same', activation='relu')(x)\n    x = layers.BatchNormalization()(x)\n    if len(skip_connections) >= 1:\n        x = layers.Concatenate()([x, skip_connections[0]])\n    x = layers.Conv2D(64, 3, padding='same', activation='relu')(x); x = layers.BatchNormalization()(x)\n\n    x = layers.Conv2D(32, 3, padding='same', activation='relu')(x)\n    outputs = layers.Conv2D(NUM_CLASSES, 1, activation='softmax', name='segmentation')(x)\n    return keras.Model(inputs, outputs, name=\"FewShotSegmentation\")\n\n# ============ K-shot split ============\ndef prepare_k_shot_data(X, Y, class_labels, k):\n    unique_classes = list(set(class_labels))\n    X_train_k, Y_train_k, X_val, Y_val, X_test, Y_test = [], [], [], [], [], []\n    for class_name in unique_classes:\n        idxs = [i for i,l in enumerate(class_labels) if l == class_name]\n        np.random.shuffle(idxs)\n        Nc = len(idxs)\n        n_val_test = max(0, (Nc - k) // 2)\n        train_indices = idxs[:k]\n        val_indices   = idxs[k:k + n_val_test]\n        test_indices  = idxs[k + n_val_test:k + 2*n_val_test]\n        X_train_k += [X[i] for i in train_indices]\n        Y_train_k += [Y[i] for i in train_indices]\n        X_val     += [X[i] for i in val_indices]\n        Y_val     += [Y[i] for i in val_indices]\n        X_test    += [X[i] for i in test_indices]\n        Y_test    += [Y[i] for i in test_indices]\n        print(f\"Class {class_name}: Nc={Nc}, k={k}, val={len(val_indices)}, test={len(test_indices)}\")\n    return (np.array(X_train_k), np.array(Y_train_k),\n            np.array(X_val), np.array(Y_val),\n            np.array(X_test), np.array(Y_test))\n\n# ============ Train / Eval / Viz ============\ndef train_k_shot_segmentation(X_train, Y_train, X_val, Y_val, k, cae_weights_path):\n    Y_train_oh = tf.one_hot(Y_train, NUM_CLASSES).numpy()\n    Y_val_oh   = tf.one_hot(Y_val,   NUM_CLASSES).numpy()\n    model = build_few_shot_segmentation_model((IMG_SIZE, IMG_SIZE, 3), cae_weights_path)\n    model.compile(optimizer=keras.optimizers.Adam(1e-3),\n                  loss=combined_segmentation_loss,\n                  metrics=[mean_iou_metric, dice_score_metric, 'accuracy'])\n    callbacks = [\n        keras.callbacks.EarlyStopping(monitor='val_loss', patience=PATIENCE, restore_best_weights=True, verbose=1),\n        keras.callbacks.ModelCheckpoint(os.path.join(OUTDIR, f'fsl_segmentation_k{k}_best.h5'),\n                                        monitor='val_mean_iou_metric', mode='max', save_best_only=True, verbose=1),\n        keras.callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=5, min_lr=1e-7, verbose=1)\n    ]\n    history = model.fit(X_train, Y_train_oh,\n                        validation_data=(X_val, Y_val_oh),\n                        batch_size=max(1, k), epochs=EPOCHS,\n                        callbacks=callbacks, verbose=1, shuffle=True)\n    return model, history\n\ndef evaluate_segmentation_model(model, X_test, Y_test, k):\n    Y_test_oh = tf.one_hot(Y_test, NUM_CLASSES).numpy()\n    results = model.evaluate(X_test, Y_test_oh, verbose=0)\n    preds = model.predict(X_test, verbose=0)\n    mean_iou = float(mean_iou_metric(Y_test_oh, preds).numpy())\n    dice     = float(dice_score_metric(Y_test_oh, preds).numpy())\n    print(f\"\\nK={k} Segmentation Results:\")\n    print(f\"  Loss: {results[0]:.4f}\")\n    print(f\"  Mean IoU: {mean_iou:.4f}\")\n    print(f\"  Dice Score: {dice:.4f}\")\n    print(f\"  Accuracy: {results[3]:.4f}\")\n    return {'k': k, 'loss': float(results[0]), 'mean_iou': mean_iou, 'dice_score': dice, 'accuracy': float(results[3])}\n\ndef visualize_segmentation_results(model, X_test, Y_test, k, n_samples=4):\n    if len(X_test) == 0:\n        print(\"No test samples to visualize.\")\n        return\n    n_samples = min(n_samples, len(X_test))\n    indices = np.random.choice(len(X_test), n_samples, replace=False)\n    preds = model.predict(X_test[indices], verbose=0)\n    pred_masks = np.argmax(preds, axis=-1)\n    fig, axes = plt.subplots(n_samples, 3, figsize=(12, 3*n_samples))\n    if n_samples == 1:\n        axes = axes.reshape(1, -1)\n    for i in range(n_samples):\n        axes[i,0].imshow(X_test[indices[i]]); axes[i,0].set_title('Original'); axes[i,0].axis('off')\n        axes[i,1].imshow(mask_to_color(Y_test[indices[i]])); axes[i,1].set_title('Ground Truth'); axes[i,1].axis('off')\n        axes[i,2].imshow(mask_to_color(pred_masks[i])); axes[i,2].set_title('Prediction'); axes[i,2].axis('off')\n    plt.suptitle(f'K={k} Few-Shot Segmentation Results')\n    plt.tight_layout()\n    save_path = os.path.join(OUTDIR, f'segmentation_results_k{k}.png')\n    plt.savefig(save_path, dpi=300, bbox_inches='tight'); plt.show()\n    print(f\"Visualization saved: {save_path}\")\n\ndef plot_k_shot_training_history(history, k):\n    fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n    axes[0, 0].plot(history.history['loss']);                 axes[0, 0].plot(history.history['val_loss'])\n    axes[0, 0].set_title(f'K={k} Loss');                      axes[0, 0].set_xlabel('Epoch'); axes[0,0].legend(['train','val']); axes[0,0].grid(True)\n    axes[0, 1].plot(history.history['mean_iou_metric']);      axes[0,1].plot(history.history['val_mean_iou_metric'])\n    axes[0, 1].set_title(f'K={k} Mean IoU');                  axes[0,1].legend(['train','val']); axes[0,1].grid(True)\n    axes[1, 0].plot(history.history['dice_score_metric']);    axes[1,0].plot(history.history['val_dice_score_metric'])\n    axes[1, 0].set_title(f'K={k} Dice');                      axes[1,0].legend(['train','val']); axes[1,0].grid(True)\n    axes[1, 1].plot(history.history['accuracy']);             axes[1,1].plot(history.history['val_accuracy'])\n    axes[1, 1].set_title(f'K={k} Accuracy');                  axes[1,1].legend(['train','val']); axes[1,1].grid(True)\n    plt.tight_layout()\n    save_path = os.path.join(OUTDIR, f'training_history_k{k}.png')\n    plt.savefig(save_path, dpi=300, bbox_inches='tight'); plt.show()\n    print(f\"Training history saved: {save_path}\")\n\n# ============ Main ============ \ndef run_experiment_3():\n    print(\"=\"*60); print(\"Experiment 3: Few-Shot Image Segmentation\"); print(\"=\"*60)\n    start_time = time.time()\n    dataset = AppleLeafSegmentationDataset(BASE_DIR, IMG_SIZE)\n    X, Y, paths = dataset.load()\n    class_labels = dataset.class_labels\n    print(f\"Total segmentation samples: {len(X)}\")\n\n    all_results = []\n    for k in K_VALUES:\n        print(f\"\\n{'='*40}\\nTraining & evaluating k={k}\\n{'='*40}\")\n        X_tr, Y_tr, X_va, Y_va, X_te, Y_te = prepare_k_shot_data(X, Y, class_labels, k)\n        if len(X_tr) == 0 or len(X_va) == 0 or len(X_te) == 0:\n            print(f\"Skipping k={k} (insufficient samples).\")\n            continue\n        model, history = train_k_shot_segmentation(X_tr, Y_tr, X_va, Y_va, k, CAE_WEIGHTS_PATH)\n        plot_k_shot_training_history(history, k)\n        res = eva